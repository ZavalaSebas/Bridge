<Window x:Class="Bridge.GameInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Bridge.Converters"
        Title="Game Info"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinWidth="380" MaxWidth="480">
    <Window.Resources>
        <converters:ReleaseDateConverter x:Key="ReleaseDateConverter" />
        <converters:PlaytimeConverter x:Key="PlaytimeConverter" />
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="{Binding SelectedGame.Name}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedGame.ReleaseDate, Converter={StaticResource ReleaseDateConverter}}"
                       Margin="0,2,0,0" Foreground="Gray" FontSize="12" />
            <TextBlock Margin="0,6,0,0" Foreground="Gray" FontSize="12">
                <Run Text="Critic: " />
                <Run Text="{Binding SelectedGame.CriticScore, Mode=OneWay, TargetNullValue='—'}" FontWeight="SemiBold" />
                <Run Text="/100  ·  Community: " />
                <Run Text="{Binding SelectedGame.CommunityScore, Mode=OneWay, TargetNullValue='—'}" FontWeight="SemiBold" />
                <Run Text="/100" />
            </TextBlock>
            <TextBlock Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                       Text="{Binding SelectedGame.InstallDirectory, Mode=OneWay, TargetNullValue='Not installed'}" />
            <TextBlock Margin="0,6,0,0" Foreground="Gray">
                <Run Text="Playtime: " />
                <Run Text="{Binding SelectedGame.PlaytimeSeconds, Mode=OneWay, Converter={StaticResource PlaytimeConverter}}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                       Text="{Binding DevelopersText, Mode=OneWay}" />
            <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                       Text="{Binding PublishersText, Mode=OneWay}" />
            <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                       Text="{Binding PlatformsText, Mode=OneWay}" />
            <Separator Margin="0,10,0,10" />
            <TextBlock Text="{Binding SelectedGame.Description, Mode=OneWay, TargetNullValue='No description.'}"
                       TextWrapping="Wrap" FontSize="13" />
        </StackPanel>
    </ScrollViewer>
</Window>
