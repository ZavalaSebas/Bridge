<UserControl x:Class="Bridge.Controls.AchievementHeroSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Bridge.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                Visibility="{Binding HasSummary, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                ToolTip="{Binding SummaryToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Border Width="1"
                Height="26"
                Margin="16,0,16,0"
                Background="{DynamicResource Bridge.SeparatorBrush}"
                VerticalAlignment="Center" />
        <ui:SymbolIcon Symbol="Trophy24"
                       FontSize="16"
                       Foreground="{StaticResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" />
        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{x:Static res:Strings.Achievements}"
                       FontSize="11"
                       Foreground="{StaticResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{Binding SummaryText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Bridge.SystemAccentBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </StackPanel>
</UserControl>
