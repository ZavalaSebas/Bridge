<UserControl x:Class="Bridge.Controls.FadeImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ControlRoot">
    <Grid x:Name="ImageHolder">
        <Image x:Name="Image1"
               Stretch="{Binding Stretch, ElementName=ControlRoot}"
               RenderOptions.BitmapScalingMode="Fant" />
        <Image x:Name="Image2"
               Stretch="{Binding Stretch, ElementName=ControlRoot}"
               RenderOptions.BitmapScalingMode="Fant"
               Opacity="0" />
    </Grid>
</UserControl>
