<UserControl x:Class="Bridge.Controls.AchievementsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Bridge.Resources"
             xmlns:converters="clr-namespace:Bridge.Converters"
             xmlns:controls="clr-namespace:Bridge.Controls"
             xmlns:entities="clr-namespace:Bridge.Core.Entities;assembly=Bridge.Core"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             mc:Ignorable="d"
             d:DesignHeight="448" d:DesignWidth="720">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:AchievementNameConverter x:Key="AchievementNameConverter" />
        <converters:AchievementDescriptionConverter x:Key="AchievementDescriptionConverter" />
        <converters:AchievementIconConverter x:Key="AchievementIconConverter" />
        <converters:AchievementUnlockedAtConverter x:Key="AchievementUnlockedAtConverter" />
        <converters:AchievementLockedOpacityConverter x:Key="AchievementLockedOpacityConverter" />
        <converters:AchievementRarityLabelConverter x:Key="AchievementRarityLabelConverter" />
        <converters:AchievementRarityBrushConverter x:Key="AchievementRarityBrushConverter" />
        <converters:AchievementGlobalPercentConverter x:Key="AchievementGlobalPercentConverter" />
        <converters:AchievementRarityVisibilityConverter x:Key="AchievementRarityVisibilityConverter" />
        <converters:AchievementUnlockedAccentVisibilityConverter x:Key="AchievementUnlockedAccentVisibilityConverter" />
        <DataTemplate x:Key="AchievementCardTemplate" DataType="{x:Type entities:GameAchievement}">
            <Border Margin="0,0,4,4"
                    Height="72"
                    HorizontalAlignment="Stretch"
                    Padding="8,0"
                    CornerRadius="8"
                    Background="{DynamicResource Bridge.Surface.Background}"
                    BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                    BorderThickness="1">
                <Border.ToolTip>
                    <ToolTip MaxWidth="320">
                        <StackPanel>
                            <TextBlock Text="{Binding Converter={StaticResource AchievementNameConverter}}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Converter={StaticResource AchievementDescriptionConverter}}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="3"
                            Margin="0,4,6,4"
                            CornerRadius="2"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                            Visibility="{Binding Converter={StaticResource AchievementUnlockedAccentVisibilityConverter}}"/>

                    <Border Grid.Column="1"
                            Width="40"
                            Height="40"
                            Margin="0,0,8,0"
                            CornerRadius="7"
                            ClipToBounds="True"
                            Background="#151A28"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Image Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="Fant"
                               Opacity="{Binding Converter={StaticResource AchievementLockedOpacityConverter}}"
                               converters:CachedImage.SourceUrl="{Binding Converter={StaticResource AchievementIconConverter}}"
                               converters:CachedImage.DecodeSize="Icon"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Converter={StaticResource AchievementNameConverter}}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,0,2"/>

                        <TextBlock Text="{Binding Converter={StaticResource AchievementDescriptionConverter}}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   MaxHeight="14"
                                   Margin="0,0,0,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal">
                            <Border Padding="6,1"
                                    Margin="0,0,6,0"
                                    CornerRadius="8"
                                    VerticalAlignment="Center"
                                    Background="{Binding Converter={StaticResource AchievementRarityBrushConverter}}"
                                    Visibility="{Binding Converter={StaticResource AchievementRarityVisibilityConverter}}">
                                <TextBlock Text="{Binding Converter={StaticResource AchievementRarityLabelConverter}}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding Converter={StaticResource AchievementUnlockedAtConverter}}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Converter={StaticResource AchievementGlobalPercentConverter}}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource Bridge.MutedSurface.Background}"
            CornerRadius="8"
            Padding="12"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch">
        <Grid>
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="420">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAchievements, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{x:Static res:Strings.AchievementsLoading}"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding EmptyMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                        <Condition Binding="{Binding HasAchievements, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Margin="0,12,0,0"
                        Padding="16,8"
                        HorizontalAlignment="Center"
                        Click="ConfigureRetroAchievements_Click"
                        AutomationProperties.Name="{x:Static res:Strings.OpenRetroAchievementsSettings}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                        <Condition Binding="{Binding HasAchievements, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                        <Condition Binding="{Binding ShowsConfigureRetroAchievementsButton, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{x:Static res:Strings.OpenRetroAchievementsSettings}"/>
                </Button>
            </StackPanel>

            <Grid Visibility="{Binding HasAchievements, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProgressText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Foreground="{StaticResource TextFillColorPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CompletionPercentText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ProgressBar Height="7"
                                 Margin="0,0,0,6"
                                 Minimum="0"
                                 Maximum="{Binding ProgressMaximum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="{Binding ProgressValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Background="{DynamicResource Bridge.SeparatorBrush}"
                                 Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                 BorderThickness="0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowsProgress, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <TextBlock Text="{Binding RemainingText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{StaticResource TextFillColorTertiaryBrush}"
                               FontSize="11"/>
                </StackPanel>

                <ScrollViewer x:Name="AchievementsScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              controls:ScrollViewerChaining.IsEnabled="True">
                    <ItemsControl ItemsSource="{Binding Achievements, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  HorizontalAlignment="Stretch"
                                  ItemTemplate="{StaticResource AchievementCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
