<ui:FluentWindow x:Class="Bridge.IgdbSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Name="Root"
        Title="{x:Static res:Strings.IgdbSettingsTitle}"
        Width="460" Height="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}"
        xmlns:res="clr-namespace:Bridge.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Background="{DynamicResource Bridge.Sidebar.Background}"
                     BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                     BorderThickness="0,0,0,1"
                     Height="56"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="18"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Static res:Strings.IgdbSettingsTitle}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,12">
                <TextBlock Text="{x:Static res:Strings.IgdbSettingsHelp}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="0,0,0,12">
                    <Run Text="1. "/><Run Text="{x:Static res:Strings.IgdbTutorialStep1}"/>
                    <LineBreak/>
                    <Run Text="2. "/><Run Text="{x:Static res:Strings.IgdbTutorialStep2}"/>
                    <LineBreak/>
                    <Run Text="3. "/><Run Text="{x:Static res:Strings.IgdbTutorialStep3}"/>
                    <LineBreak/>
                    <Run Text="4. "/><Run Text="{x:Static res:Strings.IgdbTutorialStep4}"/>
                </TextBlock>
                <Button HorizontalAlignment="Left" Padding="0,4" Margin="0,0,0,14" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OpenTwitchDeveloper_Click">
                    <TextBlock Text="{x:Static res:Strings.IgdbOpenDeveloperConsole}" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextDecorations="Underline"/>
                </Button>

                <TextBlock Text="{x:Static res:Strings.ClientId}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Padding="6,4"/>

                <TextBlock Text="{x:Static res:Strings.ClientSecret}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="SecretBox" Margin="0,0,0,8" Padding="6,4"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,12,20,16"
                BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Bridge.Sidebar.Background}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True" Width="100" Padding="0,7" Margin="0,0,8,0"/>
                <Button Content="{x:Static res:Strings.Save}" Width="100" Padding="0,7" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
