<Window x:Class="Bridge.IgdbSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGDB Settings" Height="260" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12">
            Get a free Client ID and Secret from a Twitch Developer account:
            dev.twitch.tv/console/apps — register any app, "Client Type" doesn't matter for this.
        </TextBlock>

        <TextBlock Text="Client ID" />
        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <TextBlock Text="Client Secret" />
        <TextBox Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <Button Content="Save" Padding="8,4" HorizontalAlignment="Left" Command="{Binding SaveCommand}" />
        <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Gray" />
    </StackPanel>
</Window>
