<UserControl x:Class="Bridge.Views.StatisticsOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Bridge.Converters"
             xmlns:art="clr-namespace:Bridge.Assets"
             xmlns:res="clr-namespace:Bridge.Resources">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Bridge;component/Styles/MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="StatisticsGameChipTemplate">
                <Border Margin="0,4,0,0"
                        Padding="8"
                        CornerRadius="10"
                        Background="{DynamicResource Bridge.Card.Background}"
                        BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32"
                                Height="44"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Image Stretch="UniformToFill"
                                   converters:CachedImage.SourceUrl="{Binding CoverImage}"
                                   converters:CachedImage.DecodeSize="Cover"
                                   converters:CachedImage.FallbackArtwork="{x:Static art:GameArtworkFallback.Cover}"
                                   RenderOptions.BitmapScalingMode="Fant"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding PlaytimeSeconds, Converter={StaticResource PlaytimeConverter}}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text=" · "
                                           FontSize="11"
                                           Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding CompletedAt, Converter={StaticResource EmptyToVis}}"/>
                                <TextBlock Text="{Binding CompletedAt, Converter={StaticResource ShortDateConverter}}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding CompletedAt, Converter={StaticResource EmptyToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="StatisticsTimelineTemplate">
                <Border Margin="0,0,0,12"
                        Padding="14"
                        CornerRadius="14"
                        Background="{DynamicResource Bridge.Card.Background}"
                        BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52"
                                Height="72"
                                CornerRadius="12"
                                ClipToBounds="True">
                            <Image Stretch="UniformToFill"
                                   converters:CachedImage.SourceUrl="{Binding Game.CoverImage}"
                                   converters:CachedImage.DecodeSize="Cover"
                                   converters:CachedImage.FallbackArtwork="{x:Static art:GameArtworkFallback.Cover}"
                                   RenderOptions.BitmapScalingMode="Fant"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <Border Padding="8,4"
                                    CornerRadius="999"
                                    HorizontalAlignment="Left"
                                    Background="{Binding BadgeText, Converter={StaticResource CompletionStatusToColor}}">
                                <TextBlock Text="{Binding BadgeText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding Detail}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TimestampText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Top"
                                   Margin="12,4,0,0"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <Border CornerRadius="20"
                    Background="{DynamicResource Bridge.Card.Background}"
                    BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                    BorderThickness="1"
                    Padding="20"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="72"
                            Height="72"
                            CornerRadius="36"
                            ClipToBounds="True"
                            BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                            BorderThickness="1">
                        <Image Stretch="UniformToFill"
                               Source="{Binding UserProfile, Converter={StaticResource UserProfileAvatarConverter}, ConverterParameter=112}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserProfile.DisplayName}"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static res:Strings.Statistics}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding StatisticsSummary}"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{x:Static res:Strings.Statistics}"
                       FontSize="{StaticResource Bridge.FontSize.Title}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <UniformGrid Columns="5" Margin="0,0,0,18">
                <Border Padding="14" Margin="0,4,8,0" CornerRadius="14" Background="{DynamicResource Bridge.Card.Background}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.BacklogBoard}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Statistics.BacklogCount}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Padding="14" Margin="8,4,8,0" CornerRadius="14" Background="{DynamicResource Bridge.Card.Background}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.InProgressBoard}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Statistics.InProgressCount}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Padding="14" Margin="8,4,8,0" CornerRadius="14" Background="{DynamicResource Bridge.Card.Background}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.CompletedBoard}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Statistics.CompletedCount}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Padding="14" Margin="8,4,0,0" CornerRadius="14" Background="{DynamicResource Bridge.Card.Background}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.AbandonedBoard}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Statistics.AbandonedCount}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Padding="14" Margin="8,4,0,0" CornerRadius="14" Background="{DynamicResource Bridge.Card.Background}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.OtherStatusBoard}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Statistics.OtherCompletionCount}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <WrapPanel Margin="0,0,0,18">
                <Border Width="210" Padding="14" Margin="0,4,8,0" CornerRadius="14" Background="{DynamicResource Bridge.Card.Background}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.All}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Statistics.TotalCount, Converter={StaticResource GamesCount}}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="210" Padding="14" Margin="8,4,8,0" CornerRadius="14" Background="{DynamicResource Bridge.Card.Background}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Installed}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Statistics.InstalledCount}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="210" Padding="14" Margin="8,4,8,0" CornerRadius="14" Background="{DynamicResource Bridge.Card.Background}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Favorites}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Statistics.FavoriteCount}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="210" Padding="14" Margin="8,4,8,0" CornerRadius="14" Background="{DynamicResource Bridge.Card.Background}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Hidden}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Statistics.HiddenCount}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="210" Padding="14" Margin="8,4,8,0" CornerRadius="14" Background="{DynamicResource Bridge.Card.Background}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Total}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Statistics.TotalPlaytimeDisplay}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="210" Padding="14" Margin="8,4,0,0" CornerRadius="14" Background="{DynamicResource Bridge.Card.Background}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Average}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Statistics.AveragePlaytimeDisplay}" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border CornerRadius="18"
                    Background="{DynamicResource Bridge.Card.Background}"
                    BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="Board24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Static res:Strings.CompletionBoard}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{x:Static res:Strings.CompletionBoardHint}"
                               FontSize="12"
                               Foreground="{StaticResource TextFillColorTertiaryBrush}"
                               Margin="0,0,0,14"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Statistics.CompletionBoardColumns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,12,0"
                                            Padding="14"
                                            MinWidth="240"
                                            CornerRadius="14"
                                            Background="{DynamicResource ApplicationBackgroundBrush}"
                                            BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CountText}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       Margin="0,8,0,10"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextFillColorTertiaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource StatisticsGameChipTemplate}">
                                                <ItemsControl.Resources>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Margin" Value="0"/>
                                                    </Style>
                                                </ItemsControl.Resources>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border CornerRadius="18"
                    Background="{DynamicResource Bridge.Card.Background}"
                    BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="History24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Static res:Strings.StatisticsTimeline}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{x:Static res:Strings.StatisticsTimelineHint}"
                               FontSize="12"
                               Foreground="{StaticResource TextFillColorTertiaryBrush}"
                               Margin="0,0,0,14"/>
                    <ItemsControl ItemsSource="{Binding Statistics.TimelineEntries}" ItemTemplate="{StaticResource StatisticsTimelineTemplate}"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="18"
                    Background="{DynamicResource Bridge.Card.Background}"
                    BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                    BorderThickness="1"
                    Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="ChartMultiple24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                        <TextBlock Text="{x:Static res:Strings.TopPlayTime}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Statistics.TopPlayed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        CornerRadius="12"
                                        Background="{DynamicResource ApplicationBackgroundBrush}"
                                        BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Height="24"
                                               Width="24"
                                               Stretch="Uniform"
                                               converters:CachedImage.SourceUrl="{Binding Icon}"
                                               converters:CachedImage.DecodeSize="Icon"
                                               converters:CachedImage.FallbackArtwork="{x:Static art:GameArtworkFallback.Icon}"
                                               RenderOptions.BitmapScalingMode="Fant"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PlaytimeSeconds, Converter={StaticResource PlaytimeConverter}}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                   FontSize="{StaticResource Bridge.FontSize.BodySmall}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
