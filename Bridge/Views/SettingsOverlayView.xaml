<UserControl x:Class="Bridge.Views.SettingsOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:Bridge.Resources">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="920">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:SymbolIcon Symbol="Settings24" FontSize="22" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                <TextBlock Text="{x:Static res:Strings.Settings}" FontSize="{StaticResource Bridge.FontSize.Title}" FontWeight="SemiBold" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{x:Static res:Strings.SettingsDescription}" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="0,0,0,24"/>

            <TextBlock Text="{x:Static res:Strings.SettingsProfileSection}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
            <Border Margin="0,0,0,24" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Person24" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="{x:Static res:Strings.SettingsProfileTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{x:Static res:Strings.SettingsProfileDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,14"/>
                    <TextBlock Text="{x:Static res:Strings.SetupDisplayNameLabel}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <TextBox x:Name="ProfileDisplayNameBox" Padding="8,6" MaxLength="40" Margin="0,0,0,14"/>
                    <TextBlock Text="{x:Static res:Strings.SetupAvatarLabel}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="72" Height="72" CornerRadius="36" ClipToBounds="True"
                                BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1">
                            <Image x:Name="ProfileAvatarPreview" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="ProfileChoosePhotoButton" HorizontalAlignment="Left" Padding="12,6" Click="ProfileChoosePhoto_Click"
                                    Content="{x:Static res:Strings.SetupChoosePhoto}"/>
                            <Button x:Name="ProfileUseDefaultAvatarButton" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6" Click="ProfileUseDefaultAvatar_Click"
                                    Content="{x:Static res:Strings.SetupUseDefaultAvatar}"/>
                        </StackPanel>
                    </Grid>
                    <UniformGrid x:Name="ProfileDefaultAvatarGrid" Columns="6" Rows="1" Margin="0,0,0,14"/>
                    <Button x:Name="SaveProfileButton" HorizontalAlignment="Left" MinWidth="120" Padding="14,7" Click="SaveProfile_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextOnAccentFillColorPrimaryBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorSecondaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{x:Static res:Strings.SettingsSaveProfile}"/>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Static res:Strings.SettingsIntegrations}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" MinWidth="88" Padding="12,8" VerticalAlignment="Center" Click="ConfigureEmulator_Click" AutomationProperties.Name="{x:Static res:Strings.ConfigureEmulatorTitle}">
                            <TextBlock Text="{x:Static res:Strings.OpenEmulationSettings}"/>
                        </Button>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Box24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.ConfigureEmulatorTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsEmulationCardDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Margin="4,0,4,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" MinWidth="88" Padding="12,8" VerticalAlignment="Center" Click="IgdbSettings_Click" AutomationProperties.Name="{x:Static res:Strings.IgdbSettingsTitle}">
                            <TextBlock Text="{x:Static res:Strings.OpenIgdbSettings}"/>
                        </Button>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Database24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.IgdbSettingsTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsIgdbCardDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Margin="8,0,0,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" MinWidth="88" Padding="12,8" VerticalAlignment="Center" Click="SteamGridDbSettings_Click" AutomationProperties.Name="{x:Static res:Strings.SteamGridDbSettingsTitle}">
                            <TextBlock Text="{x:Static res:Strings.OpenSteamGridDbSettings}"/>
                        </Button>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.SteamGridDbSettingsTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsSteamGridDbCardDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Margin="0,0,0,24" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" MinWidth="88" Padding="12,8" VerticalAlignment="Center" Click="RetroAchievementsSettings_Click" AutomationProperties.Name="{x:Static res:Strings.RetroAchievementsSettingsTitle}">
                        <TextBlock Text="{x:Static res:Strings.OpenRetroAchievementsSettings}"/>
                    </Button>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Trophy24" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static res:Strings.RetroAchievementsSettingsTitle}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SettingsRetroAchievementsCardDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{x:Static res:Strings.SettingsAppearance}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" MinWidth="88" Padding="12,8" VerticalAlignment="Center" Click="CustomThemeColor_Click" AutomationProperties.Name="{x:Static res:Strings.CustomThemeColorTitle}">
                            <TextBlock Text="{x:Static res:Strings.OpenThemeSettings}"/>
                        </Button>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Color24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.CustomThemeColorTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsThemeCardDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <ComboBox DockPanel.Dock="Right" x:Name="LanguageCombo" MinWidth="140" VerticalAlignment="Center" SelectionChanged="LanguageCombo_SelectionChanged" AutomationProperties.Name="{x:Static res:Strings.SettingsLanguageTitle}">
                            <ComboBoxItem Content="{x:Static res:Strings.SettingsLanguageEnglish}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.SettingsLanguageSpanish}"/>
                        </ComboBox>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.SettingsLanguageTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsLanguageDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <ui:ToggleSwitch DockPanel.Dock="Right" x:Name="TrayIconToggle" VerticalAlignment="Center" Margin="12,0,0,0" Checked="TrayIconToggle_Changed" Unchecked="TrayIconToggle_Changed" AutomationProperties.Name="{x:Static res:Strings.SettingsTrayIconTitle}"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="TrayItemAdd24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.SettingsTrayIconTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsTrayIconDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <ui:ToggleSwitch DockPanel.Dock="Right" x:Name="KeepSelectionToggle" VerticalAlignment="Center" Margin="12,0,0,0" Checked="KeepSelectionToggle_Changed" Unchecked="KeepSelectionToggle_Changed" AutomationProperties.Name="{x:Static res:Strings.SettingsKeepSelectionTitle}"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.SettingsKeepSelectionTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsKeepSelectionDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <ComboBox DockPanel.Dock="Right" x:Name="DetailPanelPositionCombo" MinWidth="140" VerticalAlignment="Center" SelectionChanged="DetailPanelPositionCombo_SelectionChanged" AutomationProperties.Name="{x:Static res:Strings.SettingsDetailPanelPositionTitle}">
                            <ComboBoxItem Content="{x:Static res:Strings.Left}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.Right}"/>
                        </ComboBox>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="PanelRight24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.SettingsDetailPanelPositionTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsDetailPanelPositionDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <ComboBox DockPanel.Dock="Right" x:Name="DetailSectionPositionCombo" MinWidth="140" VerticalAlignment="Center" SelectionChanged="DetailSectionPositionCombo_SelectionChanged" AutomationProperties.Name="{x:Static res:Strings.SettingsDetailSectionPositionTitle}">
                            <ComboBoxItem Content="{x:Static res:Strings.Left}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.Right}"/>
                        </ComboBox>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ColumnTriple24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.SettingsDetailSectionPositionTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsDetailSectionPositionDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <ui:ToggleSwitch DockPanel.Dock="Right" x:Name="TranslucentSidebarToggle" VerticalAlignment="Center" Margin="12,0,0,0" Checked="TranslucentSidebarToggle_Changed" Unchecked="TranslucentSidebarToggle_Changed" AutomationProperties.Name="{x:Static res:Strings.SettingsTranslucentSidebarTitle}"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="PanelLeft24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.SettingsTranslucentSidebarTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsTranslucentSidebarDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <ui:ToggleSwitch DockPanel.Dock="Right" x:Name="TranslucentBackgroundToggle" VerticalAlignment="Center" Margin="12,0,0,0" Checked="TranslucentBackgroundToggle_Changed" Unchecked="TranslucentBackgroundToggle_Changed" AutomationProperties.Name="{x:Static res:Strings.SettingsTranslucentBackgroundTitle}"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ImageAltText24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.SettingsTranslucentBackgroundTitle}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsTranslucentBackgroundDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <TextBlock Text="{x:Static res:Strings.SettingsDataSection}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
            <Border Margin="0,0,0,24" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button MinWidth="112" Padding="12,8" Click="CreateBackup_Click" AutomationProperties.Name="{x:Static res:Strings.CreateBackup}">
                            <TextBlock Text="{x:Static res:Strings.CreateBackup}"/>
                        </Button>
                        <Button MinWidth="112" Padding="12,8" Margin="0,8,0,0" Click="RestoreBackup_Click" AutomationProperties.Name="{x:Static res:Strings.RestoreBackup}">
                            <TextBlock Text="{x:Static res:Strings.RestoreBackup}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="Archive24" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static res:Strings.SettingsBackupTitle}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SettingsBackupDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{x:Static res:Strings.SettingsUpdatesSection}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static res:Strings.CheckForUpdates}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Padding="12,8" HorizontalAlignment="Left" Command="{Binding CheckForUpdatesCommand}" AutomationProperties.Name="{x:Static res:Strings.CheckForUpdates}">
                            <TextBlock Text="{x:Static res:Strings.CheckForUpdates}"/>
                        </Button>
                        <Border Margin="0,14,0,0" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static res:Strings.ReceiveBetaBuilds}" FontWeight="Medium" FontSize="13"/>
                                    <TextBlock Text="{x:Static res:Strings.BetaBuildsDescription}" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="BetaChannelToggle" VerticalAlignment="Center" Margin="14,0,0,0" Checked="BetaChannelToggle_Changed" Unchecked="BetaChannelToggle_Changed"/>
                            </Grid>
                        </Border>
                        <Border Margin="0,10,0,0" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Static res:Strings.SettingsStartWithWindows}" FontWeight="Medium" FontSize="13"/>
                                    <TextBlock x:Name="StartWithWindowsDescription" Text="{x:Static res:Strings.SettingsStartWithWindowsDescription}" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" x:Name="StartWithWindowsToggle" VerticalAlignment="Center" Margin="14,0,0,0" Checked="StartWithWindowsToggle_Changed" Unchecked="StartWithWindowsToggle_Changed"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="8" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="16">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" MinWidth="88" Padding="12,8" VerticalAlignment="Center" Click="About_Click" AutomationProperties.Name="{x:Static res:Strings.AboutBridge}">
                            <TextBlock Text="{x:Static res:Strings.ViewAbout}"/>
                        </Button>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.AboutBridge}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SettingsAboutCardDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
