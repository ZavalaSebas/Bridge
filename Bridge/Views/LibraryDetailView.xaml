ackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="PreviewMouseLeftButtonDown"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.08"/><DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.08"/></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="PreviewMouseLeftButtonUp"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></EventTrigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><Grid><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="{Binding PlayButtonSymbol}" FontSize="22" VerticalAlignment="Center" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"/><TextBlock Text="{Binding PlayButtonText}" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}" FontSize="17"/></StackPanel></Grid></Button><ui:Button x:Name="DetailMoreButton" Appearance="Secondary" Content="{x:Static res:Strings.More}" AutomationProperties.Name="{x:Static res:Strings.More}" Margin="8,0,0,0" Padding="22,10" BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="1" Click="MenuButton_Click" ContextMenu="{StaticResource Bridge.GameContextMenu}"></ui:Button><ui:Button x:Name="DetailEditButton" Margin="8,0,0,0" Padding="16,10" Click="EditGame_Click" ToolTip="{x:Static res:Strings.Edit}" AutomationProperties.Name="{x:Static res:Strings.Edit}"><ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="Appearance" Value="Secondary"/><Setter Property="Visibility" Value="Collapsed"/><Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=DetailButtonsRow}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ui:Button.Style><ui:SymbolIcon Symbol="Edit24" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/></ui:Button></StackPanel>
