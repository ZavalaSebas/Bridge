                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PanelRight24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
