                                                                            Background="#2EC4C4"
                                                                            Visibility="{Binding TimeToBeatMainSeconds, Converter={StaticResource PositiveULongToVis}}">
                                                                        <Border.Width>
                                                                            <MultiBinding Converter="{StaticResource TimeToBeatSegmentWidth}"
                                                                                          ConverterParameter="0">
                                                                                <Binding Path="TimeToBeatMainSeconds" />
                                                                                <Binding Path="TimeToBeatExtraSeconds" />
                                                                                <Binding Path="TimeToBeatCompleteSeconds" />
                                                                                <Binding ElementName="HltbTrack" Path="ActualWidth" />
                                                                            </MultiBinding>
                                                                        </Border.Width>
                                                                        <TextBlock Text="{Binding TimeToBeatMainSeconds, Converter={StaticResource TimeToBeatHoursMinutes}}"
                                                                                   Foreground="White"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="6,0" />
                                                                    </Border>
                                                                    <Border Height="22"
                                                                            Background="#5B82F0"
                                                                            BorderBrush="{DynamicResource Bridge.Panel.Background}"
                                                                            BorderThickness="1,0,0,0"
                                                                            Visibility="{Binding TimeToBeatExtraSeconds, Converter={StaticResource PositiveULongToVis}}">
                                                                        <Border.Width>
                                                                            <MultiBinding Converter="{StaticResource TimeToBeatSegmentWidth}"
                                                                                          ConverterParameter="1">
                                                                                <Binding Path="TimeToBeatMainSeconds" />
                                                                                <Binding Path="TimeToBeatExtraSeconds" />
                                                                                <Binding Path="TimeToBeatCompleteSeconds" />
                                                                                <Binding ElementName="HltbTrack" Path="ActualWidth" />
                                                                            </MultiBinding>
