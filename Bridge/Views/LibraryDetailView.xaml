                                            <ColumnDefinition x:Name="OverviewTabsColumn" Width="*" MinWidth="300"/>
                                            <ColumnDefinition x:Name="DetailsMetadataColumn" Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="OverviewTabsSection" Grid.Column="0" Margin="0,0,20,0" ClipToBounds="True" MinWidth="0" HorizontalAlignment="Stretch">
                                            <TabControl x:Name="DetailOverviewTabs"
                                                        Style="{StaticResource Bridge.DetailTabControl}"
                                                        ItemContainerStyle="{StaticResource Bridge.DetailTabItem}"
                                                        HorizontalAlignment="Stretch"
                                                        MinWidth="0">
                                                <TabItem Header="{x:Static res:Strings.Overview}">
                                                    <ScrollViewer x:Name="OverviewScrollViewer"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  VerticalAlignment="Stretch"
                                                                  HorizontalAlignment="Stretch"
                                                                  controls:ScrollViewerChaining.IsEnabled="True">
                                                        <Border Background="{DynamicResource Bridge.MutedSurface.Background}"
                                                                CornerRadius="8"
                                                                Padding="12"
                                                                VerticalAlignment="Top"
                                                                HorizontalAlignment="Stretch"
