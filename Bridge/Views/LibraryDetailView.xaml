                                                                        <Binding Path="TimeToBeatMainSeconds" Mode="OneWay" />
                                                                        <Binding Path="TimeToBeatExtraSeconds" Mode="OneWay" />
                                                                        <Binding Path="TimeToBeatCompleteSeconds" Mode="OneWay" />
                                                                        <Binding ElementName="HltbTrack" Path="ActualWidth" />
