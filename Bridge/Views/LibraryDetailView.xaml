                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <controls:AchievementHeroSummary Grid.Column="6"
                                                                             VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Bridge.SeparatorBrush}"/>
                                <StackPanel Grid.Row="1">
