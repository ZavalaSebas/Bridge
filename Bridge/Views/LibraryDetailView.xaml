nter"/><TextBlock Text="{Binding Zoom, StringFormat={}{0:0.0}x}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Grid>
                    <Border Grid.Column="1" x:Name="CompactInfoPanel" Width="320" Visibility="Collapsed" Background="#CC1B2132" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1,0,0,0">
