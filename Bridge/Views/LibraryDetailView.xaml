fo}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="Info24" FontSize="18"/><TextBlock Text="{x:Static res:Strings.Info}" Margin="8,0,0,0" FontSize="14" VerticalAlignment="Center"/></StackPanel></ui:Button><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxHeight="56" MaxWidth="150" TextAlignment="Center" Margin="0,16,0,0"/></StackPanel></Border><Border x:Name="SelectionRing" CornerRadius="8" BorderThickness="2" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Bridge.SystemAccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Bridge.SystemAccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border></Grid><ControlTemplate.Triggers><EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="{StaticResource Bridge.Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="{StaticResource Bridge.Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="22" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="CardShado