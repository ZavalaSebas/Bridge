                                                                            Visibility="{Binding TimeToBeatCompleteSeconds, Converter={StaticResource PositiveULongToVis}}">
                                                                        <Border.Width>
                                                                            <MultiBinding Converter="{StaticResource TimeToBeatSegmentWidth}"
