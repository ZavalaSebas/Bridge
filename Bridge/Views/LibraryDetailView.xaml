                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PanelLeft24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.Right}"
