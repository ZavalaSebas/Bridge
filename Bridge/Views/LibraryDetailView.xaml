                                            </TabControl>
                                        </Border>
                                        <StackPanel x:Name="DetailsSection" Grid.Column="1" MinWidth="0">
                                            <TextBlock Text="{x:Static res:Strings.Details}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
                                            <views:GameDetailsFieldsPanel DataContext="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Visibility="{Binding Links.Count, Converter={StaticResource NonZeroToVis}}" Margin="20,0,20,24" MaxWidth="1120" HorizontalAlignment="Center"><Border Background="{DynamicResource Bridge.Surface.Background}" CornerRadius="8" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="10,9,10,4"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><ui:SymbolIcon Symbol="Link24" FontSize="14" Foreground="{StaticResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{x:Static res:Strings.Links}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/></StackPanel><ItemsControl ItemsSource="{Binding Links}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><StaticResource ResourceKey="Bridge.GameLinkChipTemplate"/></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel></ScrollViewer></Grid>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="3" Background="{DynamicResource ApplicationBackgroundBrush}"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NavigationSection}" Value="{x:Static enums:NavigationSection.Settings}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><views:SettingsOverlayView /></Grid>
            <Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Grid.RowSpan="3" Background="{DynamicResource ApplicationBackgroundBrush}"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NavigationSection}" Value="{x:Static enums:NavigationSection.Statistics}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><views:StatisticsOverlayView /></Grid>
            </Grid>
</UserControl>




