                                                            <ItemsControl HorizontalAlignment="Stretch"
                                                                          ItemsSource="{Binding Converter={StaticResource DescriptionBlocks}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplateSelector><controls:DescriptionBlockTemplateSelector TextTemplate="{StaticResource DescTextTemplate}" HeadingTemplate="{StaticResource DescHeadingTemplate}" SubheadingTemplate="{StaticResource DescSubheadingTemplate}" ListTemplate="{StaticResource DescListTemplate}" ImageTemplate="{StaticResource DescImageTemplate}"/></ItemsControl.ItemTemplateSelector></ItemsControl>
                                                        </Border>
                                                    </ScrollViewer>
