<UserControl x:Class="Bridge.Views.RomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:res="clr-namespace:Bridge.Resources"
             xmlns:converters="clr-namespace:Bridge.Converters"
             x:Name="RomsRoot">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Bridge;component/Styles/MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibility"/>
            <converters:FallbackCoverConverter x:Key="FallbackCoverConverter"/>

            <!-- Shared row navigation arrow (same language as the Home rows). -->
            <Style x:Key="RomRowArrow" TargetType="Button">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Background" Value="#CC1E2436"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Opacity" Value="0.75"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E61E2436"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF1E2436"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Big cover card that scales on hover (Switch-style shelf item). -->
            <Style x:Key="RomCoverCard" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Panel.ZIndex" Value="10"/>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.06" Duration="{StaticResource Bridge.Motion.Fast}"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.06" Duration="{StaticResource Bridge.Motion.Fast}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Bridge.Motion.Fast}"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Bridge.Motion.Fast}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RomCoverFrame" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="ClipToBounds" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource Bridge.Card.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Bridge.SeparatorBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Bridge.SystemAccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RomSectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">

        <!-- Empty state: no ROM games yet. -->
        <Grid Visibility="{Binding RomsHasGames, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <ui:SymbolIcon Symbol="Games24" FontSize="48" Foreground="{StaticResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Static res:Strings.ScanRomsHelp}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,24" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="14"/>
                <Button Padding="16,10" HorizontalAlignment="Center" Background="{DynamicResource SystemAccentColorPrimaryBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ScanRoms_Click">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="{x:Static res:Strings.ScanRoms}"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Per-platform shelves. -->
        <ScrollViewer x:Name="MainScrollHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Padding="0,0,0,24"
                      Visibility="{Binding RomsHasGames, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="24,20,24,14">
                    <Border Width="4" Height="24" CornerRadius="2" Background="{DynamicResource Bridge.SystemAccentBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{x:Static res:Strings.SidebarRoms}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding RomShelves}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="24,0,24,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Bridge.SystemAccentBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding PlatformName}" Style="{StaticResource RomSectionTitle}"/>
                                    <Border CornerRadius="9" Padding="7,1" Margin="10,0,0,0" Background="{DynamicResource Bridge.Card.Background}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Games.Count}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <Grid>
                                    <ScrollViewer x:Name="ShelfScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" CanContentScroll="True"
                                                  PreviewMouseWheel="RowScrollViewer_PreviewMouseWheel" PreviewMouseLeftButtonDown="RowScrollViewer_PreviewMouseDown"
                                                  PreviewMouseMove="RowScrollViewer_PreviewMouseMove" PreviewMouseLeftButtonUp="RowScrollViewer_PreviewMouseUp"
                                                  MouseLeave="RowScrollViewer_MouseLeave" Cursor="Hand">
                                        <ItemsControl ItemsSource="{Binding Games}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource RomCoverCard}" Margin="0,0,16,0" Click="GameCard_Click" Tag="{Binding}" ContextMenu="{StaticResource Bridge.GameContextMenu}">
                                                        <StackPanel Width="172">
                                                            <Grid Height="258">
                                                                <Border Style="{StaticResource RomCoverFrame}">
                                                                    <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CoverImage, Converter={StaticResource FallbackCoverConverter}}"/>
                                                                </Border>
                                                                <Border CornerRadius="10" Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BoolToVisibility}}">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="#00000000" Offset="0.45"/>
                                                                            <GradientStop Color="#CC000000" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <ui:SymbolIcon Symbol="Info24" FontSize="34" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.95"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" MaxWidth="172"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Style="{StaticResource RomRowArrow}" Click="RowLeft_Click" Tag="{Binding ElementName=ShelfScroll}"><ui:SymbolIcon Symbol="ChevronLeft16" FontSize="14" Foreground="White"/></Button>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource RomRowArrow}" Click="RowRight_Click" Tag="{Binding ElementName=ShelfScroll}"><ui:SymbolIcon Symbol="ChevronRight16" FontSize="14" Foreground="White"/></Button>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
