<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =================================================================== -->
    <!-- BRIDGE THEME — paleta dark-first sobre los tokens semánticos de      -->
    <!-- Wpf.Ui 3.x. Este diccionario se mergea DESPUÉS de ThemesDictionary / -->
    <!-- ControlsDictionary en App.xaml, así que sus definiciones ganan.      -->
    <!-- Los brushes del tema de Wpf.Ui referencian sus colores con           -->
    <!-- StaticResource, por eso aquí se overridean SIEMPRE ambos (Color y    -->
    <!-- Brush) por cada token.                                               -->
    <!-- =================================================================== -->

    <!-- Acentos: el primario (#007ACC) es navegación/UI general y además es
         el SystemAccent que Wpf.Ui inyecta en AccentButton*; el secundario
         (#10B981) es EXCLUSIVO del botón Play / CTAs de lanzamiento, no se
         usa en navegación ni focus. -->
    <Color x:Key="Bridge.Accent.Primary.Color">#007ACC</Color>
    <Color x:Key="Bridge.Accent.Secondary.Color">#10B981</Color>

    <Color x:Key="SystemAccentColorPrimary">#007ACC</Color>
    <Color x:Key="SystemAccentColorSecondary">#2B9ADE</Color>
    <Color x:Key="SystemAccentColorTertiary">#0063A8</Color>

    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource SystemAccentColorSecondary}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource SystemAccentColorTertiary}" />

    <!-- Accent brush propio de Bridge (reemplazable en runtime por el ThemeManager). -->
    <SolidColorBrush x:Key="Bridge.SystemAccentBrush" Color="{StaticResource SystemAccentColorPrimary}" />

    <!-- Overrides de los accent brushes de Wpf.Ui (los usan Slider/CheckBox/Button/
         selection, etc.). Al apuntar al Color token de Bridge, el ThemeManager puede
         reemplazarlos y todo el acento cambia junto. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource SystemAccentColorPrimary}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource SystemAccentColorSecondary}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource SystemAccentColorTertiary}" />

    <!-- Fondos: tinte azul/indigo (como el MainColor de Playnite #2C3A67) en vez
         de gris puro, para darle personalidad a la paleta dark. -->
    <Color x:Key="Bridge.Background.Primary.Color">#151A28</Color>
    <Color x:Key="Bridge.Background.Secondary.Color">#1B2132</Color>
    <Color x:Key="Bridge.Background.Tertiary.Color">#232B40</Color>
    <Color x:Key="Bridge.Background.Quaternary.Color">#2C3550</Color>

    <!-- Texto -->
    <Color x:Key="Bridge.Text.Primary.Color">#E0E0E0</Color>
    <Color x:Key="Bridge.Text.Secondary.Color">#9A9A9A</Color>
    <Color x:Key="Bridge.Text.Muted.Color">#6A6A6A</Color>
    <Color x:Key="Bridge.Text.Disabled.Color">#555555</Color>
    <Color x:Key="Bridge.Text.OnAccent.Color">#FFFFFF</Color>

    <!-- Estados -->
    <Color x:Key="Bridge.Status.Success.Color">#10B981</Color>
    <Color x:Key="Bridge.Status.Warning.Color">#F59E0B</Color>
    <Color x:Key="Bridge.Status.Error.Color">#EF4444</Color>
    <Color x:Key="Bridge.Status.Info.Color">#3B82F6</Color>

    <!-- =================================================================== -->
    <!-- Overrides semánticos Wpf.Ui 3.x (Color + Brush)                     -->
    <!-- =================================================================== -->

    <!-- Application / solid backgrounds -->
    <Color x:Key="ApplicationBackgroundColor">{StaticResource Bridge.Background.Primary.Color}</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Bridge.Background.Primary.Color}" />

    <Color x:Key="SolidBackgroundFillColorBase">{StaticResource Bridge.Background.Primary.Color}</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Bridge.Background.Primary.Color}" />
    <Color x:Key="SolidBackgroundFillColorBaseAlt">{StaticResource Bridge.Background.Primary.Color}</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{StaticResource Bridge.Background.Primary.Color}" />
    <Color x:Key="SolidBackgroundFillColorSecondary">{StaticResource Bridge.Background.Secondary.Color}</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource Bridge.Background.Secondary.Color}" />
    <Color x:Key="SolidBackgroundFillColorTertiary">{StaticResource Bridge.Background.Tertiary.Color}</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource Bridge.Background.Tertiary.Color}" />
    <Color x:Key="SolidBackgroundFillColorQuarternary">{StaticResource Bridge.Background.Quaternary.Color}</Color>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource Bridge.Background.Quaternary.Color}" />

    <!-- Text fills -->
    <Color x:Key="TextFillColorPrimary">{StaticResource Bridge.Text.Primary.Color}</Color>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Bridge.Text.Primary.Color}" />
    <Color x:Key="TextFillColorSecondary">{StaticResource Bridge.Text.Secondary.Color}</Color>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Bridge.Text.Secondary.Color}" />
    <Color x:Key="TextFillColorTertiary">{StaticResource Bridge.Text.Muted.Color}</Color>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Bridge.Text.Muted.Color}" />
    <Color x:Key="TextFillColorDisabled">{StaticResource Bridge.Text.Disabled.Color}</Color>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource Bridge.Text.Disabled.Color}" />
    <Color x:Key="TextOnAccentFillColorPrimary">{StaticResource Bridge.Text.OnAccent.Color}</Color>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource Bridge.Text.OnAccent.Color}" />

    <!-- Control fills -->
    <Color x:Key="ControlFillColorDefault">{StaticResource Bridge.Background.Tertiary.Color}</Color>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Bridge.Background.Tertiary.Color}" />
    <Color x:Key="ControlFillColorSecondary">{StaticResource Bridge.Background.Quaternary.Color}</Color>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource Bridge.Background.Quaternary.Color}" />
    <Color x:Key="ControlFillColorTertiary">#3A3A3A</Color>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#3A3A3A" />
    <Color x:Key="ControlFillColorInputActive">{StaticResource Bridge.Background.Secondary.Color}</Color>
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource Bridge.Background.Secondary.Color}" />
    <Color x:Key="ControlSolidFillColorDefault">{StaticResource Bridge.Background.Tertiary.Color}</Color>
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{StaticResource Bridge.Background.Tertiary.Color}" />

    <!-- Subtle / alt fills (hover, selected rows) -->
    <Color x:Key="SubtleFillColorSecondary">{StaticResource Bridge.Background.Secondary.Color}</Color>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Bridge.Background.Secondary.Color}" />
    <Color x:Key="SubtleFillColorTertiary">{StaticResource Bridge.Background.Tertiary.Color}</Color>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource Bridge.Background.Tertiary.Color}" />
    <Color x:Key="ControlAltFillColorSecondary">{StaticResource Bridge.Background.Secondary.Color}</Color>
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="{StaticResource Bridge.Background.Secondary.Color}" />
    <Color x:Key="ControlAltFillColorTertiary">{StaticResource Bridge.Background.Tertiary.Color}</Color>
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="{StaticResource Bridge.Background.Tertiary.Color}" />

    <!-- Borders -->
    <Color x:Key="ControlStrokeColorDefault">#3A4668</Color>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#3A4668" />
    <Color x:Key="ControlStrokeColorSecondary">#4A5878</Color>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#4A5878" />
    <Color x:Key="ControlStrongFillColorDefault">#4A5878</Color>
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#4A5878" />
    <Color x:Key="SurfaceStrokeColorDefault">#3A4668</Color>
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#3A4668" />

    <!-- Status -->
    <Color x:Key="SystemFillColorSuccess">{StaticResource Bridge.Status.Success.Color}</Color>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource Bridge.Status.Success.Color}" />
    <Color x:Key="SystemFillColorCaution">{StaticResource Bridge.Status.Warning.Color}</Color>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource Bridge.Status.Warning.Color}" />
    <Color x:Key="SystemFillColorCritical">{StaticResource Bridge.Status.Error.Color}</Color>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource Bridge.Status.Error.Color}" />
    <Color x:Key="SystemFillColorAttention">{StaticResource Bridge.Status.Info.Color}</Color>
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource Bridge.Status.Info.Color}" />

    <!-- =================================================================== -->
    <!-- TIPOGRAFÍA — Inter Variable (embebida en Fonts/)                    -->
    <!-- =================================================================== -->

    <FontFamily x:Key="Bridge.FontFamily">pack://application:,,,/Fonts/#Inter</FontFamily>

    <sys:Double x:Key="Bridge.FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="Bridge.FontSize.BodySmall">12</sys:Double>
    <sys:Double x:Key="Bridge.FontSize.Body">13</sys:Double>
    <sys:Double x:Key="Bridge.FontSize.BodyLarge">14</sys:Double>
    <sys:Double x:Key="Bridge.FontSize.Heading">15</sys:Double>
    <sys:Double x:Key="Bridge.FontSize.Title">20</sys:Double>
    <sys:Double x:Key="Bridge.FontSize.TitleLarge">24</sys:Double>
    <sys:Double x:Key="Bridge.FontSize.Display">34</sys:Double>

    <FontWeight x:Key="Bridge.FontWeight.Normal">400</FontWeight>
    <FontWeight x:Key="Bridge.FontWeight.Medium">500</FontWeight>
    <FontWeight x:Key="Bridge.FontWeight.SemiBold">600</FontWeight>

    <!-- =================================================================== -->
    <!-- ESPACIADO Y RADIO (sistema 4px)                                     -->
    <!-- =================================================================== -->

    <Thickness x:Key="Bridge.Spacing.XS">4</Thickness>
    <Thickness x:Key="Bridge.Spacing.SM">8</Thickness>
    <Thickness x:Key="Bridge.Spacing.MD">12</Thickness>
    <Thickness x:Key="Bridge.Spacing.LG">16</Thickness>
    <Thickness x:Key="Bridge.Spacing.XL">24</Thickness>

    <CornerRadius x:Key="Bridge.CornerRadius.Control">4</CornerRadius>
    <CornerRadius x:Key="Bridge.CornerRadius.Card">8</CornerRadius>
    <CornerRadius x:Key="Bridge.CornerRadius.Overlay">12</CornerRadius>

    <!-- =================================================================== -->
    <!-- MOTION — duraciones y easings                                       -->
    <!-- =================================================================== -->

    <Duration x:Key="Bridge.Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Bridge.Motion.Normal">0:0:0.15</Duration>
    <Duration x:Key="Bridge.Motion.Slow">0:0:0.2</Duration>

    <KeySpline x:Key="Bridge.Easing.EaseOut">0.25, 0.46, 0.45, 0.94</KeySpline>
    <KeySpline x:Key="Bridge.Easing.EaseInOut">0.42, 0, 0.58, 1</KeySpline>

    <!-- =================================================================== -->
    <!-- BRUSHES PROPIOS DE BRIDGE                                           -->
    <!-- =================================================================== -->

    <!-- Acento secundario (Play/CTA). No tocar el SystemAccent: es azul. -->
    <SolidColorBrush x:Key="Bridge.Accent.SecondaryBrush" Color="{StaticResource Bridge.Accent.Secondary.Color}" />

    <!-- Sidebar: semitransparente para dejar pasar el Mica/Acrylic de la
         ventana (efecto vidrio). Sobre el fallback sólido de Win10 se ve
         simplemente como un panel oscuro — aceptable. Con el fondo borroso del
         juego seleccionado detrás, la translucidez es la que crea el look de
         "cristal empañado" (como el default theme de Playnite). -->
    <SolidColorBrush x:Key="Bridge.Sidebar.Background" Color="{StaticResource Bridge.Background.Secondary.Color}" Opacity="0.75" />

    <!-- Frosted-glass window background: el fondo del juego seleccionado, borroso
         y oscurecido, detrás de todo el contenido (replica de
         FadeImage + BlurEffect de Playnite). -->
    <sys:Double x:Key="Bridge.Background.BlurRadius">40</sys:Double>
    <SolidColorBrush x:Key="Bridge.Background.DarkOverlay" Color="#B2000000" />

    <SolidColorBrush x:Key="Bridge.SeparatorBrush" Color="#34415F" />

    <!-- Pilares de fondo para filas / tarjetas -->
    <SolidColorBrush x:Key="Bridge.Card.Background" Color="{StaticResource Bridge.Background.Secondary.Color}" />
    <SolidColorBrush x:Key="Bridge.Card.Hover" Color="{StaticResource Bridge.Background.Quaternary.Color}" />

    <!-- Acento-tinted hover para filas seleccionables (estilo Playnite HoverColor) -->
    <SolidColorBrush x:Key="Bridge.Accent.Hover" Color="#1F4E79" />

    <!-- Scrollbar con pulgar de acento (como el GlyphBrush de Playnite). -->
    <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" VerticalAlignment="Stretch">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PART_UpButton" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PART_DownButton" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False" IsTabStop="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" CornerRadius="5" Margin="2,1" Background="{DynamicResource SystemAccentColorPrimaryBrush}" Opacity="0.5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="12" />
                            <Setter TargetName="PART_Track" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical" />
                            <Setter TargetName="PART_UpButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                            <Setter TargetName="PART_DownButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
