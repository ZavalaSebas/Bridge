<ui:FluentWindow x:Class="Bridge.ThemeColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Name="Root"
        Title="{x:Static res:Strings.CustomThemeColorTitle}"
        Width="440" Height="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}"
        xmlns:res="clr-namespace:Bridge.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Background="{DynamicResource Bridge.Sidebar.Background}"
                     BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                     BorderThickness="0,0,0,1"
                     Height="56"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:SymbolIcon Symbol="Color24" FontSize="18"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Static res:Strings.CustomThemeColorTitle}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,16,24,20">
            <TextBlock Text="{x:Static res:Strings.CustomThemeColorDescription}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextFillColorSecondaryBrush}"
                       FontSize="13"
                       Margin="0,0,0,14"/>
            <WrapPanel x:Name="SwatchPanel"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
