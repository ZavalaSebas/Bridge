<Window x:Class="Bridge.EmulatorSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Emulator" Height="320" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Name" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <TextBlock Text="Install Directory" />
        <TextBox Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <TextBlock Text="Executable (relative to Install Directory, or absolute)" />
        <TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <TextBlock Text="Arguments (use {RomPath} where the ROM path goes)" />
        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <TextBlock Text="ROM extensions (comma-separated, e.g. nes, zip)" />
        <TextBox Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <Button Content="Save" Padding="8,4" HorizontalAlignment="Left" Command="{Binding SaveCommand}" />
        <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap" />
    </StackPanel>
</Window>
