<ui:FluentWindow x:Class="Bridge.EmulatorSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Name="Root"
        Title="{x:Static res:Strings.ConfigureEmulatorTitle}"
        Width="460" Height="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}"
        xmlns:res="clr-namespace:Bridge.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Background="{DynamicResource Bridge.Sidebar.Background}"
                     BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                     BorderThickness="0,0,0,1"
                     Height="56"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="18"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Static res:Strings.ConfigureEmulatorTitle}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,12">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Name}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="6,4"/>

                <TextBlock Text="{x:Static res:Strings.InstallDirectory}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="6,4"/>

                <TextBlock Text="{x:Static res:Strings.ExecutableRelativeOrAbsolute}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="6,4"/>

                <TextBlock Text="{x:Static res:Strings.ArgumentsRomPathPlaceholder}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="6,4"/>

                <TextBlock Text="{x:Static res:Strings.RomExtensionsCommaSeparated}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="6,4"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,12,20,16"
                BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Bridge.Sidebar.Background}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True" Width="100" Padding="0,7" Margin="0,0,8,0"/>
                <Button Content="{x:Static res:Strings.Save}" Command="{Binding SaveCommand}" Width="100" Padding="0,7" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
