<Window x:Class="Bridge.GameQuickViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:Bridge.Resources"
        xmlns:controls="clr-namespace:Bridge.Controls"
        xmlns:converters="clr-namespace:Bridge.Converters"
        xmlns:art="clr-namespace:Bridge.Assets"
        Title="{Binding Name}" Height="620" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Hero with close + nav arrows, no white title bar -->
                    <Grid Height="280" ClipToBounds="True">
                        <controls:FadeImage SourceUrl="{Binding BackgroundImage, Converter={StaticResource HeroArtSource}}" FallbackArtwork="{x:Static art:GameArtworkFallback.Background}" Stretch="UniformToFill" DecodeSize="Hero"/>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#CC0B0F1E" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Width="30" Height="30" Background="#66000000" BorderThickness="0" Foreground="White" Cursor="Hand" Click="Close_Click">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="White"/>
                        </Button>
                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16" MaxWidth="700" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" Foreground="White" TextWrapping="Wrap">
                                <TextBlock.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.7"/></TextBlock.Effect>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="PlayButton" MinWidth="120" Padding="14,7" Cursor="Hand" Click="Play_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Bridge.StopBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon x:Name="PlayIcon" FontSize="16" Foreground="White" VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Play24"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Symbol" Value="Stop24"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding NeedsEmulatorDownload}" Value="True"><Setter Property="Symbol" Value="ArrowDownload24"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock x:Name="PlayText" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{x:Static res:Strings.Play}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Text" Value="{x:Static res:Strings.Stop}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding NeedsEmulatorDownload}" Value="True"><Setter Property="Text" Value="{x:Static res:Strings.Download}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Margin="8,0,0,0" Padding="12,7" Background="#22FFFFFF" Foreground="White" BorderBrush="#44FFFFFF" BorderThickness="1" Cursor="Hand" Click="OpenDetails_Click">
                                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="White"/><TextBlock Text="{x:Static res:Strings.More}" Margin="6,0,0,0"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <!-- Overview + Screenshots without right gap -->
                    <StackPanel Margin="16,16,16,16">
                        <TextBlock Text="{x:Static res:Strings.Overview}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" Visibility="{Binding Description, Converter={StaticResource EmptyToVis}}"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextFillColorPrimaryBrush}" Visibility="{Binding Description, Converter={StaticResource EmptyToVis}}"/>
                        <TextBlock Text="{x:Static res:Strings.Screenshots}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,16,0,8" Visibility="{Binding Screenshots.Count, Converter={StaticResource NonZeroToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Screenshots}" Visibility="{Binding Screenshots.Count, Converter={StaticResource NonZeroToVis}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" CornerRadius="6" ClipToBounds="True" Background="#1A1A1A" Height="120">
                                        <Image Stretch="UniformToFill" converters:CachedImage.SourceUrl="{Binding}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
