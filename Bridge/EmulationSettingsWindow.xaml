<ui:FluentWindow x:Class="Bridge.EmulationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Name="Root"
        Title="{x:Static res:Strings.EmulationSettingsTitle}"
        Width="520" Height="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}"
        xmlns:res="clr-namespace:Bridge.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Background="{DynamicResource Bridge.Sidebar.Background}"
                     BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                     BorderThickness="0,0,0,1"
                     Height="56"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:SymbolIcon Symbol="Games24" FontSize="18"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Static res:Strings.EmulationSettingsTitle}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,12">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.EmulationManagedRetroArchHeading}"
                           FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{x:Static res:Strings.EmulationManagedRetroArchDescription}"
                           TextWrapping="Wrap" Margin="0,0,0,14"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="6" Padding="12" Margin="0,0,0,14">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="{x:Static res:Strings.EmulationSupportedSystems}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,14"/>
                <CheckBox Content="{x:Static res:Strings.AutoApplyCheatsOnLaunch}"
                          IsChecked="{Binding AutoApplyCheatsOnLaunch, Mode=TwoWay}"
                          Margin="0,0,0,6"/>
                <TextBlock Text="{x:Static res:Strings.AutoApplyCheatsOnLaunchDescription}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,12,20,16"
                BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Bridge.Sidebar.Background}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.Close}" IsCancel="True" Width="100" Padding="0,7" Margin="0,0,8,0"/>
                <Button Content="{x:Static res:Strings.CheckForUpdates}" Command="{Binding UpdateCommand}" Width="135" Padding="0,7"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
