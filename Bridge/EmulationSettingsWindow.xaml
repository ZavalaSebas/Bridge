<Window x:Class="Bridge.EmulationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emulation" Height="300" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Bridge-managed RetroArch" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="Bridge detects supported ROM platforms automatically and downloads RetroArch plus the required core when you first play. No external emulator setup is required." TextWrapping="Wrap" Margin="0,0,0,14"/>
        <Border Background="#16007ACC" CornerRadius="6" Padding="12" Margin="0,0,0,14"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/></Border>
        <TextBlock Text="Supported systems include NES, SNES, Nintendo 64, Game Boy, Game Boy Advance, Nintendo DS, Sega 8/16-bit, Atari, PC Engine and WonderSwan." TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Close" IsCancel="True" Width="90" Margin="0,0,8,0"/><Button Content="Check for updates" Command="{Binding UpdateCommand}" Width="135"/></StackPanel>
    </StackPanel>
</Window>
