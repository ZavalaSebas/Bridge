<ui:FluentWindow x:Class="Bridge.CheatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Bridge.ViewModels"
        x:Name="Root"
        Title="{Binding GameName}"
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}"
        xmlns:res="clr-namespace:Bridge.Resources">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Background="{DynamicResource Bridge.Sidebar.Background}"
                     BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                     BorderThickness="0,0,0,1"
                     Height="56"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:SymbolIcon Symbol="Games24" FontSize="18"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,12">
            <StackPanel>
                <TextBlock Text="{Binding GameName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Margin="0,0,0,12" Foreground="{StaticResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Static res:Strings.Platform}"/>
                    <Run Text=": "/>
                    <Run Text="{Binding PlatformName, Mode=OneWay}"/>
                </TextBlock>

                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsLoading}" Value="False" />
                                        <Condition Binding="{Binding HasCheats}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasCheats, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Cheats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CheatItemViewModel}">
                                <CheckBox Content="{Binding Description}" IsChecked="{Binding Enabled}"
                                          Command="{Binding DataContext.ToggleCheatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"
                                          Margin="0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding HasCheats, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Static res:Strings.CheatsAttribution}"
                               Foreground="{StaticResource TextFillColorSecondaryBrush}"
                               FontSize="11" TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="{x:Static res:Strings.Source}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding SourceFileUrl, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,12,20,16"
                BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Bridge.Sidebar.Background}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.Close}" IsCancel="True" Width="100" Padding="0,7"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
