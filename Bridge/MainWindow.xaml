        <SolidColorBrush x:Key="Bridge.SystemAccentBrush" Color="#007ACC" />
        <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="{StaticResource Bridge.Card.Background}" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="FontFamily" Value="{StaticResource Bridge.FontFamily}" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="12,0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" /></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Bridge.Card.Hover}" /></Trigger></Style.Triggers></Style>
        <Style TargetType="ListViewItem"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Padding" Value="12,8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Bridge.Card.Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="BorderBrush" Value="{StaticResource Bridge.SystemAccentBrush}" /></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <!-- Frosted-glass window background (Playnite-style): el fondo del juego
             seleccionado va borroso y oscurecido detrÃƒÆ’Ã‚Â¡s de toda la ventana; los
             paneles semitransparentes encima dejan pasar el blur = cristal
             empaÃƒÆ’Ã‚Â±ado. TamaÃƒÆ’Ã‚Â±o bindeado a la ventana para no inflar el layout. -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <Grid.CacheMode><BitmapCache /></Grid.CacheMode>
            <controls:FadeImage SourceUrl="{Binding SelectedGame.BackgroundImage}" Stretch="UniformToFill" Width="{Binding ActualWidth, ElementName=Root}" Height="{Binding ActualHeight, ElementName=Root}"><controls:FadeImage.Effect><BlurEffect Radius="{StaticResource Bridge.Background.BlurRadius}" KernelType="Gaussian" RenderingBias="Performance" /></controls:FadeImage.Effect></controls:FadeImage>
            <Border Background="{StaticResource Bridge.Background.DarkOverlay}" />
        </Grid>
        <ui:TitleBar Grid.Row="0" Background="{StaticResource Bridge.Sidebar.Background}" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="0,0,0,1" Height="56" ShowMinimize="True" ShowMaximize="True" ShowClose="True"><ui:TitleBar.Header>
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Width="48" Height="48" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Bridge menu" Click="MenuButton_Click"><Button.ContextMenu><ContextMenu Opened="MainMenu_Opened"><MenuItem Header="Add Game"><MenuItem Header="Import from Steam" Command="{Binding PlacementTarget.DataContext.ImportSteamLibraryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><MenuItem Header="Add Manually..." Click="AddGame_Click" /><MenuItem Header="Scan ROMs..." Click="ScanRom_Click" /></MenuItem><MenuItem Header="Support"><MenuItem Header="Ko-fi" Click="OpenSupportLink_Click" Tag="https://ko-fi.com/YOUR_KOFI" /><MenuItem Header="GitHub Sponsors" Click="OpenSupportLink_Click" Tag="https://github.com/sponsors/ZavalaSebas" /></MenuItem><MenuItem Header="Sidebar"><MenuItem Header="Show Sidebar" IsCheckable="True" IsChecked="True" Click="ToggleSidebar_Click" /><Separator /><MenuItem Header="Position"><MenuItem Header="Left" Click="SetSidebarPosition_Click" Tag="Left" IsChecked="True" /><MenuItem Header="Right" Click="SetSidebarPosition_Click" Tag="Right" /><MenuItem Header="Top" Click="SetSidebarPosition_Click" Tag="Top" /><MenuItem Header="Bottom" Click="SetSidebarPosition_Click" Tag="Bottom" /></MenuItem></MenuItem><Separator /><MenuItem Header="Settings"><MenuItem Header="IGDB..." Click="IgdbSettings_Click" /><MenuItem Header="Configure Emulator..." Click="ConfigureEmulator_Click" /></MenuItem><Separator /><MenuItem Header="About Bridge..." Click="About_Click" /><Separator /><MenuItem Header="Exit" Click="Exit_Click" /></ContextMenu></Button.ContextMenu><ui:SymbolIcon Symbol="Library24" FontSize="28" Foreground="{StaticResource TextFillColorPrimaryBrush}" /></Button>
                <Border DockPanel.Dock="Left" CornerRadius="6" Background="{StaticResource ControlFillColorSecondaryBrush}" Padding="10,0" Height="40" Margin="8,0,0,0" Width="460" WindowChrome.IsHitTestVisibleInChrome="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Search24" FontSize="18" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center" Padding="0,1" Foreground="{StaticResource TextFillColorPrimaryBrush}" /></Grid></Border>
                <Button DockPanel.Dock="Left" Width="40" Height="40" Background="Transparent" BorderThickness="0" Margin="6,0,0,0" ToolTip="Filter presets" Cursor="Hand" Click="MenuButton_Click"><Button.ContextMenu><ContextMenu Name="FilterPresetMenu" DataContext="{Binding}"><MenuItem Header="All" Click="FilterPresetMenu_Click" Tag="All" /><MenuItem Header="Favorites" Click="FilterPresetMenu_Click" Tag="Favorite" /><MenuItem Header="Most Played" Click="FilterPresetMenu_Click" Tag="MostPlayed" /><MenuItem Header="Recently Played" Click="FilterPresetMenu_Click" Tag="RecentlyPlayed" /></ContextMenu></Button.ContextMenu><ui:SymbolIcon Symbol="Filter24" FontSize="22" Foreground="{StaticResource TextFillColorSecondaryBrush}" /></Button>
                <Button DockPanel.Dock="Left" Width="40" Height="40" Background="Transparent" BorderThickness="0" Margin="2,0,0,0" ToolTip="Sort settings" Cursor="Hand" Click="MenuButton_Click"><Button.ContextMenu><ContextMenu Name="SortFieldMenu" DataContext="{Binding}"><MenuItem Header="Name" Click="SortFieldMenu_Click" Tag="Name" /><MenuItem Header="Playtime" Click="SortFieldMenu_Click" Tag="PlaytimeSeconds" /><MenuItem Header="Play Count" Click="SortFieldMenu_Click" Tag="PlayCount" /><MenuItem Header="Last Played" Click="SortFieldMenu_Click" Tag="RecentActivity" /><MenuItem Header="Release Date" Click="SortFieldMenu_Click" Tag="ReleaseDate" /><MenuItem Header="Developer" Click="SortFieldMenu_Click" Tag="Developer" /><MenuItem Header="Publisher" Click="SortFieldMenu_Click" Tag="Publisher" /><MenuItem Header="Source" Click="SortFieldMenu_Click" Tag="Source" /><MenuItem Header="Critic Score" Click="SortFieldMenu_Click" Tag="CriticScore" /><Separator /><MenuItem Header="Toggle Direction" Click="ToggleSortDirection_Click" /></ContextMenu></Button.ContextMenu><ui:SymbolIcon Symbol="ArrowSortDownLines24" FontSize="22" Foreground="{StaticResource TextFillColorSecondaryBrush}" /></Button>
                <Button DockPanel.Dock="Left" Width="40" Height="40" Background="Transparent" BorderThickness="0" Margin="2,0,0,0" ToolTip="Group settings" Cursor="Hand" Click="MenuButton_Click"><Button.ContextMenu><ContextMenu Name="GroupFieldMenu" DataContext="{Binding}"><MenuItem Header="None" Click="GroupFieldMenu_Click" Tag="None" /><MenuItem Header="Library" Click="GroupFieldMenu_Click" Tag="Library" /><MenuItem Header="Developer" Click="GroupFieldMenu_Click" Tag="Developer" /><MenuItem Header="Publisher" Click="GroupFieldMenu_Click" Tag="Publisher" /><MenuItem Header="Platform" Click="GroupFieldMenu_Click" Tag="Platform" /><MenuItem Header="Genre" Click="GroupFieldMenu_Click" Tag="Genre" /><MenuItem Header="Installation" Click="GroupFieldMenu_Click" Tag="IsInstalled" /><MenuItem Header="Completion" Click="GroupFieldMenu_Click" Tag="CompletionStatus" /><MenuItem Header="Time Played" Click="GroupFieldMenu_Click" Tag="PlaytimeSeconds" /><MenuItem Header="Release Year" Click="GroupFieldMenu_Click" Tag="ReleaseYear" /></ContextMenu></Button.ContextMenu><ui:SymbolIcon Symbol="Group24" FontSize="22" Foreground="{StaticResource TextFillColorSecondaryBrush}" /></Button>
                <Separator Background="{StaticResource Bridge.SeparatorBrush}" Width="1" Margin="10,8" DockPanel.Dock="Left" />
                <Border CornerRadius="4" Background="{StaticResource SolidBackgroundFillColorTertiaryBrush}" Padding="1" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal"><Button Width="40" Height="30" Background="Transparent" BorderThickness="0" ToolTip="Details view" Click="SetViewModeList_Click" Padding="0"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.List}"><Setter Property="Background" Value="{StaticResource ControlFillColorDefaultBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><ui:SymbolIcon Symbol="List24" FontSize="20"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.List}"><Setter Property="Foreground" Value="{StaticResource SystemAccentColorPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Button><Button Width="40" Height="30" Background="Transparent" BorderThickness="0" ToolTip="Grid view" Click="SetViewModeGrid_Click" Padding="0"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.Grid}"><Setter Property="Background" Value="{StaticResource ControlFillColorDefaultBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><ui:SymbolIcon Symbol="ViewDesktop24" FontSize="20"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.Grid}"><Setter Property="Foreground" Value="{StaticResource SystemAccentColorPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Button><Button Width="40" Height="30" Background="Transparent" BorderThickness="0" ToolTip="List view" Click="SetViewModeTable_Click" Padding="0"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.Table}"><Setter Property="Background" Value="{StaticResource ControlFillColorDefaultBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><ui:SymbolIcon Symbol="Table24" FontSize="20"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.Table}"><Setter Property="Foreground" Value="{StaticResource SystemAccentColorPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Button></StackPanel></Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,150,0"><ui:Button Appearance="Transparent" Padding="8" ToolTip="Select random game" Click="SelectRandomGame_Click"><ui:SymbolIcon Symbol="Shifts24" FontSize="18" /></ui:Button></StackPanel>
            </DockPanel>
        </ui:TitleBar.Header></ui:TitleBar>
<DockPanel Grid.Row="1"><Border x:Name="SidebarHost" DockPanel.Dock="Left" Width="52" Background="#44000000"><Border.ContextMenu><ContextMenu Opened="SidebarMenu_Opened"><MenuItem Header="Show Sidebar" IsCheckable="True" IsChecked="True" Click="ToggleSidebar_Click" /><Separator /><MenuItem Header="Position"><MenuItem Header="Left" Click="SetSidebarPosition_Click" Tag="Left" IsChecked="True" /><MenuItem Header="Right" Click="SetSidebarPosition_Click" Tag="Right" /><MenuItem Header="Top" Click="SetSidebarPosition_Click" Tag="Top" /><MenuItem Header="Bottom" Click="SetSidebarPosition_Click" Tag="Bottom" /></MenuItem></ContextMenu></Border.ContextMenu><StackPanel x:Name="SidebarStack" VerticalAlignment="Top"><Button Width="52" Height="52" Background="Transparent" BorderThickness="0" Click="ShowLibrary_Click" ToolTip="Library"><ui:SymbolIcon Symbol="Library24" FontSize="22"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding NavigationSection}" Value="{x:Static enums:NavigationSection.Library}"><Setter Property="Foreground" Value="{StaticResource SystemAccentColorPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Button><Button Width="52" Height="52" Background="Transparent" BorderThickness="0" Click="ShowStatistics_Click" ToolTip="Statistics"><ui:SymbolIcon Symbol="ChartMultiple24" FontSize="22"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding NavigationSection}" Value="{x:Static enums:NavigationSection.Statistics}"><Setter Property="Foreground" Value="{StaticResource SystemAccentColorPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Button></StackPanel></Border><Border x:Name="SidebarSeparator" DockPanel.Dock="Left" Width="1" Background="{StaticResource Bridge.SeparatorBrush}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="ViewsColumn" Width="360" MinWidth="200" /><ColumnDefinition Width="Auto" /><ColumnDefinition x:Name="DetailColumn" Width="*" MinWidth="320" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0"><ListBox ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"><ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.List}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListBox.Style><ListBox.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><StackPanel><ToggleButton x:Name="Expander" IsChecked="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" OverridesDefaultStyle="True" Margin="12,12,0,4"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><ContentPresenter HorizontalAlignment="Left"/></ControlTemplate></ToggleButton.Template><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></ToggleButton><ItemsPresenter Visibility="{Binding IsChecked, ElementName=Expander, Converter={StaticResource BoolToVis}}"/></StackPanel></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="0,1" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><EventSetter Event="MouseDoubleClick" Handler="List_MouseDoubleClick" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Bridge.Card.Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="BorderBrush" Value="{StaticResource Bridge.SystemAccentBrush}" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Height="28" Width="28" Stretch="Uniform" converters:CachedImage.SourceUrl="{Binding Icon}" RenderOptions.BitmapScalingMode="Fant" Margin="6,0,8,0" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{StaticResource Bridge.FontSize.BodyLarge}" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.Grid}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="CoversList" Grid.Row="0" ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0" Margin="0,32,0,0" Padding="37,24,20,16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Center"><ListBox.ItemsPanel><ItemsPanelTemplate><controls:CenteringWrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><StackPanel><ToggleButton x:Name="Expander" IsChecked="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" OverridesDefaultStyle="True" Margin="24,16,0,8"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><ContentPresenter HorizontalAlignment="Left"/></ControlTemplate></ToggleButton.Template><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></ToggleButton><ItemsPresenter Visibility="{Binding IsChecked, ElementName=Expander, Converter={StaticResource BoolToVis}}"/></StackPanel></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid x:Name="Card" Width="{Binding DataContext.Zoom, ElementName=Root, Converter={StaticResource ZoomToSize}, ConverterParameter=200}" Height="{Binding DataContext.Zoom, ElementName=Root, Converter={StaticResource ZoomToSize}, ConverterParameter=300}"><Grid.RenderTransform><ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" CenterX="100" CenterY="150"/></Grid.RenderTransform><Grid.Effect><DropShadowEffect x:Name="CardShadow" BlurRadius="0" ShadowDepth="0" Direction="90" Opacity="0" Color="#000000"/></Grid.Effect><Border CornerRadius="8" ClipToBounds="True" Background="{StaticResource ApplicationBackgroundBrush}"><Grid><Image Stretch="UniformToFill" converters:CachedImage.SourceUrl="{Binding CoverImage}" RenderOptions.BitmapScalingMode="Fant"/></Grid></Border><Border x:Name="HoverOverlay" CornerRadius="8" Opacity="0" Background="#8C000000"><Border.Style><Style TargetType="Border"><Setter Property="IsHitTestVisible" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Button Command="{Binding DataContext.PlayGameCommand, ElementName=Root}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bd" CornerRadius="8" Padding="20,9" Background="{StaticResource Bridge.Accent.SecondaryBrush}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"/><TextBlock Text="Play" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"/></StackPanel></Button><ui:Button Appearance="Secondary" Margin="0,10,0,0" Padding="22,8" Click="GameInfo_Click" Tag="{Binding}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="Info24" FontSize="15"/><TextBlock Text="Info" Margin="8,0,0,0"/></StackPanel></ui:Button><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,14,0,0"/></StackPanel></Border><Border x:Name="SelectionRing" CornerRadius="8" BorderThickness="2" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Bridge.SystemAccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border></Grid><ControlTemplate.Triggers><EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="{StaticResource Bridge.Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="{StaticResource Bridge.Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="22" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="ShadowDepth" To="10" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Bridge.Motion.Fast}"/></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Bridge.Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Bridge.Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="ShadowDepth" To="0" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Bridge.Motion.Fast}"/></Storyboard></BeginStoryboard></EventTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,4,0,8" VerticalAlignment="Center"><ui:SymbolIcon Symbol="ZoomOut24" FontSize="16" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/><Slider Value="{Binding Zoom}" Minimum="0.6" Maximum="1.6" Width="160" VerticalAlignment="Center" Margin="6,0,6,0"/><ui:SymbolIcon Symbol="ZoomIn24" FontSize="16" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding Zoom, StringFormat={}{0:0.0}x}" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Grid>
                    <Border Grid.Column="1" x:Name="CompactInfoPanel" Width="320" Visibility="Collapsed" Background="#CC252526" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="14,12,14,10">
                                <ui:Button DockPanel.Dock="Right" Width="28" Height="28" Appearance="Transparent" Padding="0" ToolTip="Close" Click="CloseCompactInfo_Click"><ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource TextFillColorSecondaryBrush}"/></ui:Button>
                                <Image DockPanel.Dock="Left" Height="32" Width="32" Stretch="Uniform" converters:CachedImage.SourceUrl="{Binding SelectedGame.Icon}" RenderOptions.BitmapScalingMode="Fant" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding SelectedGame.Name}" FontSize="{StaticResource Bridge.FontSize.Heading}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </DockPanel>
