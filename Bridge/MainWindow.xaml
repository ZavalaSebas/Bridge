<ui:FluentWindow x:Class="Bridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bridge"
        xmlns:enums="clr-namespace:Bridge.Core.Enums;assembly=Bridge.Core"
        xmlns:converters="clr-namespace:Bridge.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        x:Name="Root"
        Title="Bridge"
        Height="720" Width="1100"
        MinHeight="520" MinWidth="860"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{StaticResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <converters:ImageUrlConverter x:Key="ImageUrlConverter" />
        <converters:ReleaseDateConverter x:Key="ReleaseDateConverter" />
        <converters:PlaytimeConverter x:Key="PlaytimeConverter" />
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        <converters:BoolToIndexConverter x:Key="BoolToIndexConverter" />
        <converters:ShortDateConverter x:Key="ShortDateConverter" />
        <SolidColorBrush x:Key="Bridge.SystemAccentBrush" Color="#007ACC" />
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource Bridge.Card.Background}" />
            <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource Bridge.FontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Bridge.Card.Hover}" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Bridge.Card.Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="BorderBrush" Value="{StaticResource Bridge.SystemAccentBrush}" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- ===== TOP PANEL (Playnite exact) ===== -->
        <Border Grid.Row="0" Background="{StaticResource Bridge.Sidebar.Background}" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="0,0,0,1" Padding="110,0,0,0">
            <DockPanel VerticalAlignment="Center">

                <!-- 1. Logo → Main Menu (File, Tools, Settings, Exit) -->
                <Button DockPanel.Dock="Left" Width="44" Height="44" Background="Transparent" BorderThickness="0" Margin="5,0,0,0" Cursor="Hand" ToolTip="Bridge menu">
                    <Button.ContextMenu><ContextMenu>
                        <MenuItem Header="Add Game..." Click="AddGame_Click" />
                        <MenuItem Header="Import Steam Library" Command="{Binding PlacementTarget.DataContext.ImportSteamLibraryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Scan ROMs..." Click="ScanRom_Click" />
                        <MenuItem Header="Configure Emulator..." Click="ConfigureEmulator_Click" />
                        <MenuItem Header="IGDB Settings..." Click="IgdbSettings_Click" />
                        <Separator />
                        <MenuItem Header="Statistics" Click="ShowStatistics_Click" />
                        <MenuItem Header="Settings" Click="ShowSettings_Click" />
                        <Separator />
                        <MenuItem Header="Exit" Click="Exit_Click" />
                    </ContextMenu></Button.ContextMenu>
                    <ui:SymbolIcon Symbol="Library24" FontSize="24" Foreground="{StaticResource TextFillColorPrimaryBrush}" />
                </Button>

                <!-- 2. Search bar -->
                <Border DockPanel.Dock="Left" CornerRadius="4" Background="{StaticResource ControlFillColorSecondaryBrush}" Padding="6,0" Height="28" Margin="6,0,0,0" Width="260">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Search24" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="11" VerticalAlignment="Center" Padding="0,1" />
                    </StackPanel>
                </Border>

                <!-- 3. Filter Presets (icon button → ContextMenu) -->
                <Button DockPanel.Dock="Left" Width="34" Height="34" Background="Transparent" BorderThickness="0" Margin="6,0,0,0" ToolTip="Filter presets" Cursor="Hand">
                    <Button.ContextMenu><ContextMenu Name="FilterPresetMenu" DataContext="{Binding}">
                        <MenuItem Header="All" Click="FilterPresetMenu_Click" Tag="All" />
                        <MenuItem Header="Favorites" Click="FilterPresetMenu_Click" Tag="Favorite" />
                        <MenuItem Header="Most Played" Click="FilterPresetMenu_Click" Tag="MostPlayed" />
                        <MenuItem Header="Recently Played" Click="FilterPresetMenu_Click" Tag="RecentlyPlayed" />
                    </ContextMenu></Button.ContextMenu>
                    <ui:SymbolIcon Symbol="Filter24" FontSize="16" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- 4. Sort settings (icon button → ContextMenu) -->
                <Button DockPanel.Dock="Left" Width="34" Height="34" Background="Transparent" BorderThickness="0" Margin="2,0,0,0" ToolTip="Sort settings" Cursor="Hand">
                    <Button.ContextMenu><ContextMenu Name="SortFieldMenu" DataContext="{Binding}">
                        <MenuItem Header="Name" Click="SortFieldMenu_Click" Tag="Name" />
                        <MenuItem Header="Playtime" Click="SortFieldMenu_Click" Tag="PlaytimeSeconds" />
                        <MenuItem Header="Play Count" Click="SortFieldMenu_Click" Tag="PlayCount" />
                        <MenuItem Header="Last Played" Click="SortFieldMenu_Click" Tag="RecentActivity" />
                        <MenuItem Header="Release Date" Click="SortFieldMenu_Click" Tag="ReleaseDate" />
                        <MenuItem Header="Developer" Click="SortFieldMenu_Click" Tag="Developer" />
                        <MenuItem Header="Publisher" Click="SortFieldMenu_Click" Tag="Publisher" />
                        <MenuItem Header="Source" Click="SortFieldMenu_Click" Tag="Source" />
                        <MenuItem Header="Critic Score" Click="SortFieldMenu_Click" Tag="CriticScore" />
                        <Separator />
                        <MenuItem Header="Direction" Click="ToggleSortDirection_Click" />
                    </ContextMenu></Button.ContextMenu>
                    <ui:SymbolIcon Symbol="ArrowSortDownLines24" FontSize="16" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- 5. Group settings (icon button → ContextMenu) -->
                <Button DockPanel.Dock="Left" Width="34" Height="34" Background="Transparent" BorderThickness="0" Margin="2,0,0,0" ToolTip="Group settings" Cursor="Hand">
                    <Button.ContextMenu><ContextMenu Name="GroupFieldMenu" DataContext="{Binding}">
                        <MenuItem Header="None" Click="GroupFieldMenu_Click" Tag="None" />
                        <MenuItem Header="Library" Click="GroupFieldMenu_Click" Tag="Library" />
                        <MenuItem Header="Developer" Click="GroupFieldMenu_Click" Tag="Developer" />
                        <MenuItem Header="Publisher" Click="GroupFieldMenu_Click" Tag="Publisher" />
                        <MenuItem Header="Platform" Click="GroupFieldMenu_Click" Tag="Platform" />
                        <MenuItem Header="Genre" Click="GroupFieldMenu_Click" Tag="Genre" />
                        <MenuItem Header="Installation" Click="GroupFieldMenu_Click" Tag="IsInstalled" />
                        <MenuItem Header="Completion" Click="GroupFieldMenu_Click" Tag="CompletionStatus" />
                        <MenuItem Header="Time Played" Click="GroupFieldMenu_Click" Tag="PlaytimeSeconds" />
                        <MenuItem Header="Release Year" Click="GroupFieldMenu_Click" Tag="ReleaseYear" />
                    </ContextMenu></Button.ContextMenu>
                    <ui:SymbolIcon Symbol="Group24" FontSize="16" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                </Button>

                <Separator Background="{StaticResource Bridge.SeparatorBrush}" Width="1" Margin="10,8" DockPanel.Dock="Left" />

                <!-- 6. View mode toggle (segmented) -->
                <Border CornerRadius="4" Background="{StaticResource SolidBackgroundFillColorTertiaryBrush}" Padding="1" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="34" Height="26" Background="Transparent" BorderThickness="0" ToolTip="List view" Click="SetViewModeList_Click" Padding="0"><ui:SymbolIcon Symbol="List24" FontSize="15" /></Button>
                        <Button Width="34" Height="26" Background="Transparent" BorderThickness="0" ToolTip="Grid view" Click="SetViewModeGrid_Click" Padding="0"><ui:SymbolIcon Symbol="ViewDesktop24" FontSize="15" /></Button>
                        <Button Width="34" Height="26" Background="Transparent" BorderThickness="0" ToolTip="Details view" Click="SetViewModeTable_Click" Padding="0"><ui:SymbolIcon Symbol="Table24" FontSize="15" /></Button>
                    </StackPanel>
                </Border>

                <!-- 7-8-9. Random game + Explorer panel + Filter panel (placeholders, same as Playnite) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                    <ui:Button Appearance="Transparent" Padding="6" ToolTip="Select random game" Click="SelectRandomGame_Click"><ui:SymbolIcon Symbol="Shifts24" FontSize="16" /></ui:Button>
                    <ui:Button Appearance="Transparent" Padding="6" ToolTip="Explorer panel" Click="ToggleExplorerPanel_Click"><ui:SymbolIcon Symbol="PanelLeft24" FontSize="16" /></ui:Button>
                    <ui:Button Appearance="Transparent" Padding="6" ToolTip="Filter panel" Click="ToggleFilterPanel_Click"><ui:SymbolIcon Symbol="Filter24" FontSize="16" /></ui:Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== MAIN CONTENT: Sidebar + Game List + Detail Panel ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition x:Name="DetailColumn" Width="380" MinWidth="0" /></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Bridge.Sidebar.Background}" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top">
                    <Button Width="44" Height="44" Background="Transparent" BorderThickness="0" Margin="0,0,0,5" Cursor="Hand" ToolTip="Main menu">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Add Game..." Click="AddGame_Click" />
                            <MenuItem Header="Import Steam Library" Command="{Binding PlacementTarget.DataContext.ImportSteamLibraryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="Scan ROMs..." Click="ScanRom_Click" />
                            <MenuItem Header="Configure Emulator..." Click="ConfigureEmulator_Click" />
                            <MenuItem Header="IGDB Settings..." Click="IgdbSettings_Click" />
                            <Separator />
                            <MenuItem Header="Statistics" Click="ShowStatistics_Click" />
                            <MenuItem Header="Settings" Click="ShowSettings_Click" />
                            <Separator />
                            <MenuItem Header="Exit" Click="Exit_Click" />
                        </ContextMenu></Button.ContextMenu>
                        <ui:SymbolIcon Symbol="Library24" FontSize="20" Foreground="{StaticResource TextFillColorSecondaryBrush}" /></Button>
                    <Button Width="44" Height="44" Background="Transparent" BorderThickness="0" Click="ShowLibrary_Click" ToolTip="Library"><ui:SymbolIcon Symbol="Library24" FontSize="18" Foreground="{StaticResource SystemAccentColorPrimaryBrush}" /></Button>
                    <Button Width="44" Height="44" Background="Transparent" BorderThickness="0" Click="ShowStatistics_Click" ToolTip="Statistics"><ui:SymbolIcon Symbol="ChartMultiple24" FontSize="18" Foreground="{StaticResource TextFillColorSecondaryBrush}" /></Button>
                    <Button Width="44" Height="44" Background="Transparent" BorderThickness="0" Click="ShowSettings_Click" ToolTip="Settings"><ui:SymbolIcon Symbol="Settings24" FontSize="18" Foreground="{StaticResource TextFillColorSecondaryBrush}" /></Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Width="1" Background="{StaticResource Bridge.SeparatorBrush}" />

            <Grid Grid.Column="2">
                <ListBox ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.List}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
                    <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="8,12,0,4" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="0,1" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><EventSetter Event="MouseDoubleClick" Handler="List_MouseDoubleClick" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Bridge.Card.Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="BorderBrush" Value="{StaticResource Bridge.SystemAccentBrush}" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Height="20" Width="20" Stretch="Uniform" Source="{Binding Icon, Converter={StaticResource ImageUrlConverter}}" RenderOptions.BitmapScalingMode="Fant" Margin="4,0,6,0" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{StaticResource Bridge.FontSize.Body}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>

                <ListBox ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.Grid}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid x:Name="Card" Width="200" Height="300"><Grid.RenderTransform><ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" CenterX="100" CenterY="150"/></Grid.RenderTransform><Grid.Effect><DropShadowEffect x:Name="CardShadow" BlurRadius="0" ShadowDepth="0" Direction="90" Opacity="0" Color="#000000"/></Grid.Effect><Border CornerRadius="8" ClipToBounds="True" Background="{StaticResource ApplicationBackgroundBrush}"><Grid><Image Stretch="UniformToFill" Source="{Binding CoverImage, Converter={StaticResource ImageUrlConverter}}" RenderOptions.BitmapScalingMode="Fant"/><Border VerticalAlignment="Bottom" Padding="10,24,10,8"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E6000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxHeight="40"/></Border></Grid></Border><Border x:Name="HoverOverlay" CornerRadius="8" Opacity="0" Background="#8C000000"><Border.Style><Style TargetType="Border"><Setter Property="IsHitTestVisible" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Button Command="{Binding DataContext.PlayGameCommand, ElementName=Root}" CommandParameter="{Binding}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bd" CornerRadius="8" Padding="20,9" Background="{StaticResource Bridge.Accent.SecondaryBrush}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"/><TextBlock Text="Play" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"/></StackPanel></Button><ui:Button Appearance="Secondary" Margin="0,10,0,0" Padding="22,8" Click="GameInfo_Click" Tag="{Binding}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="Info24" FontSize="15"/><TextBlock Text="Info" Margin="8,0,0,0"/></StackPanel></ui:Button></StackPanel></Border><Border x:Name="SelectionRing" CornerRadius="8" BorderThickness="2" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Bridge.SystemAccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border></Grid><ControlTemplate.Triggers><EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="{StaticResource Bridge.Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="{StaticResource Bridge.Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="22" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="ShadowDepth" To="10" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0.5" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Bridge.Motion.Fast}"/></Storyboard></BeginStoryboard></EventTrigger><EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Bridge.Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Bridge.Motion.Fast}"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="ShadowDepth" To="0" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Bridge.Motion.Fast}"/><DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Bridge.Motion.Fast}"/></Storyboard></BeginStoryboard></EventTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>

                <ListView x:Name="TableList" ItemsSource="{Binding DetailedRows}" SelectionChanged="TableList_SelectionChanged" SizeChanged="TableList_SizeChanged">
                    <ListView.Style><Style TargetType="ListView"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.Table}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListView.Style>
                    <ListView.View><GridView>
                        <GridViewColumn Header="Name" Width="260"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" TextOptions.TextFormattingMode="Display"><Image Height="20" Width="20" Stretch="Uniform" Source="{Binding Game.Icon, Converter={StaticResource ImageUrlConverter}}" RenderOptions.BitmapScalingMode="Fant" Margin="0,0,6,0"/><TextBlock Text="{Binding Game.Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Game.Name}"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="Release" Width="90"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Game.ReleaseDate, Converter={StaticResource ReleaseDateConverter}}" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Game.ReleaseDate, Converter={StaticResource ReleaseDateConverter}}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="Genre" Width="140"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding GenresText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding GenresText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="Last Played" Width="90"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Game.LastActivity, Converter={StaticResource ShortDateConverter}}" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Game.LastActivity, Converter={StaticResource ShortDateConverter}}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="Time Played" Width="100"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Game.PlaytimeSeconds, Converter={StaticResource PlaytimeConverter}}" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Game.PlaytimeSeconds, Converter={StaticResource PlaytimeConverter}}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="Library" Width="110"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LibraryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding LibraryText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="" Width="80"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Command="{Binding DataContext.PlayGameCommand, ElementName=Root}" CommandParameter="{Binding Game}"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bd" CornerRadius="4" Padding="6,4" Background="{StaticResource Bridge.Accent.SecondaryBrush}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><ui:SymbolIcon Symbol="Play24" FontSize="13" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}" ToolTip="Play"/></Button><ui:Button Appearance="Secondary" Padding="6,4" Margin="4,0,0,0" Click="GameInfo_Click" Tag="{Binding Game}"><ui:SymbolIcon Symbol="Info24" FontSize="13" ToolTip="Info"/></ui:Button></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                    </GridView></ListView.View>
                </ListView>
            </Grid>

            <Border Grid.Column="3" Width="1" HorizontalAlignment="Center" Background="{StaticResource Bridge.SeparatorBrush}" IsHitTestVisible="False" />
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="Transparent" />

            <Border Grid.Column="4" Background="{StaticResource Bridge.Card.Background}" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="1,0,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <ui:SymbolIcon Symbol="Games32" FontSize="44" Foreground="{StaticResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Select a game" Foreground="{StaticResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="{StaticResource Bridge.FontSize.Body}" />
                        </StackPanel>
                        <Grid DataContext="{Binding SelectedGame}"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.SelectedGame, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="170" CornerRadius="4" Background="#1E1E1E" Margin="0,0,16,0"><Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="#000000"/></Border.Effect><Image Stretch="Uniform" Source="{Binding CoverImage, Converter={StaticResource ImageUrlConverter}}" RenderOptions.BitmapScalingMode="Fant"/></Border>
                                        <StackPanel Grid.Column="1"><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="{StaticResource Bridge.FontSize.Title}" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"/><TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="{Binding ReleaseDate, Converter={StaticResource ReleaseDateConverter}, TargetNullValue=''}"/><TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}"><Run Text="Critic "/><Run Text="{Binding CriticScore, Mode=OneWay, TargetNullValue=''}" FontWeight="SemiBold"/><Run Text="/100 · Community "/><Run Text="{Binding CommunityScore, Mode=OneWay, TargetNullValue=''}" FontWeight="SemiBold"/><Run Text="/100"/></TextBlock><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><CheckBox Content="Favorite" IsChecked="{Binding Favorite}" Foreground="{StaticResource TextFillColorPrimaryBrush}" Margin="0,0,12,0"/><CheckBox Content="Hidden" IsChecked="{Binding Hidden}" Foreground="{StaticResource TextFillColorPrimaryBrush}"/></StackPanel></StackPanel>
                                    </Grid><Border Height="1" Background="{StaticResource Bridge.SeparatorBrush}" Margin="0,10,0,8"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Details" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,6"/><TextBlock Margin="0,0,0,2" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Release"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding ReleaseDate, Converter={StaticResource ReleaseDateConverter}}"/><TextBlock Margin="0,0,0,2" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Playtime"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding PlaytimeSeconds, Mode=OneWay, Converter={StaticResource PlaytimeConverter}}"/><TextBlock Margin="0,0,0,2" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Genre"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding DataContext.GenresText, ElementName=Root, Mode=OneWay}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,0,0,2" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Library"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding DataContext.LibraryText, ElementName=Root, Mode=OneWay}"/><TextBlock Margin="0,0,0,2" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Dev"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding DataContext.DevelopersText, ElementName=Root, Mode=OneWay}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,0,0,2" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Publisher"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding DataContext.PublishersText, ElementName=Root, Mode=OneWay}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,0,0,2" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Platform"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding DataContext.PlatformsText, ElementName=Root, Mode=OneWay}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,0,0,2" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Install"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding InstallDirectory, Mode=OneWay, TargetNullValue='Not installed'}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Description" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,6"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="4,6" ToolTip="Collapse" Click="ToggleDetailPanel_Click" Panel.ZIndex="10"><ui:SymbolIcon Symbol="ChevronDoubleLeft20" FontSize="14"/></ui:Button>
                    </Grid>
                    <Border Grid.Row="1" Padding="12,10" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="0,1,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel><Button Command="{Binding DataContext.PlayGameCommand, ElementName=Root}" HorizontalAlignment="Stretch"><Button.Style><Style TargetType="Button"><Setter Property="Effect" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.55" Color="{StaticResource Bridge.Accent.Secondary.Color}"/></Setter.Value></Setter></Trigger></Style.Triggers></Style></Button.Style><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bd" CornerRadius="2" Padding="16,9" Background="{StaticResource Bridge.Accent.SecondaryBrush}" BorderBrush="{StaticResource Bridge.Accent.SecondaryBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"/><TextBlock Text="Play" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"/></StackPanel></Button><UniformGrid Columns="3" Margin="0,8,0,0"><ui:Button Content="Save" Command="{Binding DataContext.SaveGameCommand, ElementName=Root}"/><ui:Button Content="Delete" Margin="6,0,0,0" Command="{Binding DataContext.DeleteGameCommand, ElementName=Root}"/><ui:Button Content="Metadata" Margin="6,0,0,0" ToolTip="Download metadata" Command="{Binding DataContext.DownloadMetadataCommand, ElementName=Root}"/></UniformGrid></StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Height="28" Background="{StaticResource Bridge.Sidebar.Background}" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatisticsSummary}" FontWeight="SemiBold" FontSize="11" FontFamily="{StaticResource Bridge.FontFamily}" Foreground="{StaticResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="16,0,0,0" FontFamily="{StaticResource Bridge.FontFamily}" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>