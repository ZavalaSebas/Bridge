n Symbol="Edit24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem></MenuItem><MenuItem Header="{x:Static res:Strings.Support}"><MenuItem.Icon><ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon><MenuItem Header="{x:Static res:Strings.KoFi}" Click="OpenSupportLink_Click" Tag="{x:Static local:Config.KoFiUrl}"><MenuItem.Icon><ui:SymbolIcon Symbol="DrinkCoffee24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.GitHubSponsors}" Click="OpenSupportLink_Click" Tag="{x:Static local:Config.GitHubSponsorsUrl}"><MenuItem.Icon><ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem></MenuItem><MenuItem Header="{x:Static res:Strings.ThirdPartyClients}"><MenuItem.Icon><ui:SymbolIcon Symbol="Cloud24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.Sidebar}"><MenuItem.Icon><ui:SymbolIcon Symbol="PanelLeft24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon><MenuItem Header="{x:Static res:Strings.ShowSidebar}" Click="ToggleSidebar_Click"><MenuItem.Icon><ui:SymbolIcon FontSize="16"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Symbol" Value="Eye24"/><Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SidebarVisible}" Value="False"><Setter Property="Symbol" Value="EyeOff24"/><Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.Position}"><MenuItem.Icon><ui:SymbolI