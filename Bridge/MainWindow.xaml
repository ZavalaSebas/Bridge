                <Button TabIndex="5" Width="40" Height="40" Background="Transparent" BorderThickness="0" Margin="2,0,0,0" ToolTip="{x:Static res:Strings.GroupSettings}" AutomationProperties.Name="{x:Static res:Strings.GroupSettings}" Cursor="Hand" Click="MenuButton_Click"><Button.ContextMenu><ContextMenu Name="GroupFieldMenu" DataContext="{Binding}"><MenuItem Header="{x:Static res:Strings.DontGroup}" IsCheckable="True" IsChecked="{Binding GroupField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=None}" Click="GroupFieldMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="None" /><MenuItem Header="{x:Static res:Strings.Library}" IsCheckable="True" IsChecked="{Binding GroupField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Library}" Click="GroupFieldMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="Library" /><MenuItem Header="{x:Static res:Strings.Developer}" IsCheckable="True" IsChecked="{Binding GroupField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Developer}" Click="GroupFieldMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="Developer" /><MenuItem Header="{x:Static res:Strings.Publisher}" IsCheckable="True" IsChecked="{Binding GroupField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Publisher}" Click="GroupFieldMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="Publisher" /><MenuItem Header="{x:Static res:Strings.Platform}" IsCheckable="True" IsChecked="{Binding GroupField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Platform}" Click="GroupFieldMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="Platform" /><MenuItem Header="{x:Static res:Strings.Genre}" IsCheckable="True" IsChecked="{Binding GroupField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Genre}" Click="GroupFieldMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" T