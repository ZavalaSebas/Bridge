<ui:FluentWindow x:Class="Bridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bridge"
        xmlns:enums="clr-namespace:Bridge.Core.Enums;assembly=Bridge.Core"
        xmlns:converters="clr-namespace:Bridge.Converters"
        xmlns:controls="clr-namespace:Bridge.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        x:Name="Root"
        Title="Bridge"
        Height="860" Width="1280"
        MinHeight="520" MinWidth="860"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <converters:ReleaseDateConverter x:Key="ReleaseDateConverter" /><converters:PlaytimeConverter x:Key="PlaytimeConverter" /><converters:ShortDateConverter x:Key="ShortDateConverter" /><BooleanToVisibilityConverter x:Key="BoolToVis" /><converters:ZoomToSizeConverter x:Key="ZoomToSize" /><converters:ScoreToBrushConverter x:Key="ScoreToBrush" /><converters:EmptyToVisibilityConverter x:Key="EmptyToVis" /><converters:NonZeroToVisibilityConverter x:Key="NonZeroToVis" /><converters:DescriptionBlocksConverter x:Key="DescriptionBlocks" />
        <DataTemplate x:Key="DescTextTemplate"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="15" LineHeight="22" Margin="0,0,0,6"/></DataTemplate>
        <DataTemplate x:Key="DescImageTemplate"><Border CornerRadius="6" ClipToBounds="True" Background="#151A28" HorizontalAlignment="Stretch" MaxHeight="260" Margin="0,6,0,6"><Image MaxHeight="260" Stretch="Uniform" HorizontalAlignment="Center" converters:CachedImage.SourceUrl="{Binding Url}" RenderOptions.BitmapScalingMode="Fant"/></Border></DataTemplate>
        <controls:DescriptionBlockTemplateSelector x:Key="DescriptionBlockSelector" TextTemplate="{StaticResource DescTextTemplate}" ImageTemplate="{StaticResource DescImageTemplate}" />
        <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="{DynamicResource Bridge.Card.Background}" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="FontFamily" Value="{StaticResource Bridge.FontFamily}" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="12,0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" /></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Bridge.Accent.Hover}" /></Trigger></Style.Triggers></Style>
        <Style TargetType="ListViewItem"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Padding" Value="12,8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="OverridesDefaultStyle" Value="True" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Bridge.Accent.Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="BorderBrush" Value="{DynamicResource Bridge.SystemAccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
