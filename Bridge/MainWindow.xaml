<Window x:Class="Bridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bridge"
        xmlns:converters="clr-namespace:Bridge.Converters"
        mc:Ignorable="d"
        x:Name="Root"
        Title="Bridge" Height="700" Width="1000">
    <Window.Resources>
        <converters:ImageUrlConverter x:Key="ImageUrlConverter" />
        <converters:ReleaseDateConverter x:Key="ReleaseDateConverter" />
        <converters:PlaytimeConverter x:Key="PlaytimeConverter" />
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        <converters:BoolToIndexConverter x:Key="BoolToIndexConverter" />
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Add Game..." Click="AddGame_Click" />
                <MenuItem Header="_Import Steam Library" Command="{Binding ImportSteamLibraryCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Scan ROMs..." Click="ScanRom_Click" />
                <MenuItem Header="_Configure Emulator..." Click="ConfigureEmulator_Click" />
                <MenuItem Header="_IGDB Settings..." Click="IgdbSettings_Click" />
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <Grid DockPanel.Dock="Top" Margin="8,8,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,6,0" Padding="4,3"
                                  ItemsSource="{Binding Source={x:Static local:EnumValues.SortFields}}"
                                  SelectedItem="{Binding SortField}"
                                  ToolTip="Sort field">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="1" Padding="4,3" Width="110"
                                  SelectedIndex="{Binding SortDescending, Converter={StaticResource BoolToIndexConverter}}"
                                  ToolTip="Sort direction">
                            <ComboBoxItem Content="Ascending" />
                            <ComboBoxItem Content="Descending" />
                        </ComboBox>
                    </Grid>
                    <ComboBox DockPanel.Dock="Top" Margin="8,4,8,4" Padding="4,3"
                              ItemsSource="{Binding Source={x:Static local:EnumValues.FilterPresets}}"
                              SelectedItem="{Binding FilterPreset}"
                              ToolTip="Filter presets" />
                    <TextBox DockPanel.Dock="Top" Margin="8,0,8,4" Padding="4,3"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter games by name" />
                    <ListBox ItemsSource="{Binding GamesView}"
                             SelectedItem="{Binding SelectedGame}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image Height="32" Stretch="Uniform"
                                           Source="{Binding Icon, Converter={StaticResource ImageUrlConverter}}"
                                           RenderOptions.BitmapScalingMode="Fant" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

            <TabControl Grid.Column="1" Margin="0,4,0,0">
                <TabItem Header="Statistics">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16" DataContext="{Binding Statistics}">

                            <!-- Counts -->
                            <TextBlock Text="Library" FontWeight="SemiBold" FontSize="14" />
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="All" Grid.Column="0" Foreground="Gray" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalCount, StringFormat='{}{0} games'}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="100%" Foreground="Gray" Margin="12,0,0,0" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Installed" Grid.Column="0" Foreground="Gray" />
                                    <TextBlock Grid.Column="1" Text="{Binding InstalledCount}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding InstalledPercent, StringFormat='{}{0:0}%'}" Foreground="Gray" Margin="12,0,0,0" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Not installed" Grid.Column="0" Foreground="Gray" />
                                    <TextBlock Grid.Column="1" Text="{Binding NotInstalledCount}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding NotInstalledPercent, StringFormat='{}{0:0}%'}" Foreground="Gray" Margin="12,0,0,0" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hidden" Grid.Column="0" Foreground="Gray" />
                                    <TextBlock Grid.Column="1" Text="{Binding HiddenCount}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding HiddenPercent, StringFormat='{}{0:0}%'}" Foreground="Gray" Margin="12,0,0,0" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Favorite" Grid.Column="0" Foreground="Gray" />
                                    <TextBlock Grid.Column="1" Text="{Binding FavoriteCount}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding FavoritePercent, StringFormat='{}{0:0}%'}" Foreground="Gray" Margin="12,0,0,0" />
                                </Grid>
                            </UniformGrid>

                            <!-- Playtime -->
                            <TextBlock Text="Playtime" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,0" />
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <TextBlock Text="Total play time" Foreground="Gray" />
                                <TextBlock Text="{Binding TotalPlaytimeDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                <TextBlock Text="Average play time" Foreground="Gray" />
                                <TextBlock Text="{Binding AveragePlaytimeDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </UniformGrid>

                            <!-- Install size -->
                            <TextBlock Text="Install size" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,0" />
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <TextBlock Text="Total install size" Foreground="Gray" />
                                <TextBlock Text="{Binding TotalInstallSizeDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </UniformGrid>

                            <!-- Completion -->
                            <TextBlock Text="Completion status" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,0" />
                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                <TextBlock Text="Not played" Foreground="Gray" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} ({1:0}%)">
                                            <Binding Path="NotPlayedCount" />
                                            <Binding Path="NotPlayedPercent" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="Played" Foreground="Gray" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} ({1:0}%)">
                                            <Binding Path="PlayedCount" />
                                            <Binding Path="PlayedPercent" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </UniformGrid>

                            <!-- Top play time -->
                            <TextBlock Text="Top play time" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,0" />
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding TopPlayed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Grid.Column="0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Foreground="Gray"
                                                       Text="{Binding PlaytimeSeconds, Converter={StaticResource PlaytimeConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Game">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16" DataContext="{Binding SelectedGame}">

                    <!-- Cover + Title + Scores -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="140" Stretch="Uniform"
                               Source="{Binding CoverImage, Converter={StaticResource ImageUrlConverter}}"
                               RenderOptions.BitmapScalingMode="Fant" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="20" FontWeight="Bold" BorderThickness="0" Background="Transparent" Padding="0" />
                            <TextBlock Text="{Binding ReleaseDate, Converter={StaticResource ReleaseDateConverter}}"
                                       Margin="0,2,0,0" Foreground="Gray" FontSize="13" />
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Foreground="Gray" FontSize="12">
                                    <Run Text="Critic: " />
                                    <Run Text="{Binding CriticScore, Mode=OneWay, TargetNullValue='—'}" FontWeight="SemiBold" />
                                    <Run Text="/100  ·  Community: " />
                                    <Run Text="{Binding CommunityScore, Mode=OneWay, TargetNullValue='—'}" FontWeight="SemiBold" />
                                    <Run Text="/100" />
                                </TextBlock>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox Content="Favorite" IsChecked="{Binding Favorite}" Margin="0,0,12,0" />
                                <CheckBox Content="Hidden" IsChecked="{Binding Hidden}" />
                            </WrapPanel>

                            <!-- Playtime -->
                            <TextBlock Margin="0,12,0,0" Foreground="Gray">
                                <Run Text="Playtime: " />
                                <Run Text="{Binding PlaytimeSeconds, Mode=OneWay, StringFormat='{}{0:N0}s'}" FontWeight="SemiBold" />
                            </TextBlock>

                            <!-- Install directory -->
                            <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                                       Text="{Binding InstallDirectory, Mode=OneWay, TargetNullValue='Not installed'}" />

                            <!-- Reference fields (resolved in the ViewModel) -->
                            <TextBlock Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"
                                       Text="{Binding DataContext.DevelopersText, ElementName=Root, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.DevelopersText, ElementName=Root, Mode=OneWay}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                                       Text="{Binding DataContext.PublishersText, ElementName=Root, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.PublishersText, ElementName=Root, Mode=OneWay}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                                       Text="{Binding DataContext.PlatformsText, ElementName=Root, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.PlatformsText, ElementName=Root, Mode=OneWay}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Save" Padding="8,2" Command="{Binding DataContext.SaveGameCommand, ElementName=Root}" />
                                <Button Content="Delete" Margin="8,0,0,0" Padding="8,2" Command="{Binding DataContext.DeleteGameCommand, ElementName=Root}" />
                                <Button Content="Download Metadata" Margin="8,0,0,0" Padding="8,2" Command="{Binding DataContext.DownloadMetadataCommand, ElementName=Root}" />
                            </StackPanel>

                            <!-- Play -->
                            <Button Content="▶ Play" Margin="0,12,0,0" Padding="8,4" HorizontalAlignment="Left"
                                    FontWeight="Bold" Command="{Binding DataContext.PlayGameCommand, ElementName=Root}" />
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,12,0,0" />

                    <!-- Background Image -->
                    <TextBlock Text="Background" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <Image MinHeight="120" MaxHeight="200" Stretch="UniformToFill"
                           Source="{Binding BackgroundImage, Converter={StaticResource ImageUrlConverter}}"
                           RenderOptions.BitmapScalingMode="Fant" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock Text="{Binding StatisticsSummary}" FontWeight="SemiBold" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
        </Grid>
    </DockPanel>
</Window>
