MenuItem><MenuItem Header="{x:Static res:Strings.ThemeGreen}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#10B981"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#10B981"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemePurple}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#8B5CF6"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#8B5CF6"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemePink}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#EC4899"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#EC4899"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemeRed}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#EF4444"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#EF4444"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemeOrange}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#F97316"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#F97316"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemeAmber}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#F59E0B"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#F59E0B"/></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.CustomTheme}" Click="CustomThemeColor_Click"/></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.Settings}"><MenuItem.Icon><ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon><MenuItem Header="{x:Static res:Strings.IgdbMenu}" Click="IgdbSettings_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Database24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ConfigureEmulatorTitle}" Click="ConfigureEmulator