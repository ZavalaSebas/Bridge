<ui:FluentWindow x:Class="Bridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bridge"
        xmlns:enums="clr-namespace:Bridge.Core.Enums;assembly=Bridge.Core"
        xmlns:converters="clr-namespace:Bridge.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        x:Name="Root"
        Title="Bridge"
        Height="720" Width="1100"
        MinHeight="520" MinWidth="860"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{StaticResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <converters:ImageUrlConverter x:Key="ImageUrlConverter" />
        <converters:ReleaseDateConverter x:Key="ReleaseDateConverter" />
        <converters:PlaytimeConverter x:Key="PlaytimeConverter" />
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        <converters:BoolToIndexConverter x:Key="BoolToIndexConverter" />
        <converters:ShortDateConverter x:Key="ShortDateConverter" />
        <SolidColorBrush x:Key="Bridge.SystemAccentBrush" Color="#007ACC" />
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource Bridge.Card.Background}" />
            <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource Bridge.FontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Bridge.Card.Hover}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontFamily" Value="{StaticResource Bridge.FontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource Bridge.FontSize.Body}" />
            <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Bridge.Card.Hover}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="BorderBrush" Value="{StaticResource Bridge.SystemAccentBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Bridge" ShowMinimize="True" ShowMaximize="True" ShowClose="True" VerticalAlignment="Top">
            <ui:TitleBar.Icon><ui:SymbolIcon Symbol="Library24" FontSize="16" Foreground="{StaticResource TextFillColorPrimaryBrush}" /></ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Source={x:Static local:EnumValues.ViewModes}}" SelectedItem="{Binding ViewMode}" MinWidth="110" Height="30" VerticalAlignment="Center" ToolTip="View mode"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <ui:Button Appearance="Transparent" Padding="8" ToolTip="Menu" Click="OverflowMenu_Click"><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18" />
                        <ui:Button.ContextMenu><ContextMenu><MenuItem Header="Add Game..." Click="AddGame_Click" /><MenuItem Header="Import Steam Library" Command="{Binding PlacementTarget.DataContext.ImportSteamLibraryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><Separator /><MenuItem Header="Scan ROMs..." Click="ScanRom_Click" /><MenuItem Header="Configure Emulator..." Click="ConfigureEmulator_Click" /><MenuItem Header="IGDB Settings..." Click="IgdbSettings_Click" /><Separator /><MenuItem Header="Exit" Click="Exit_Click" /></ContextMenu></ui:Button.ContextMenu>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260" MinWidth="200" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Bridge.Sidebar.Background}" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,12">
                        <TextBlock Text="Filters" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" />
                        <ComboBox Margin="0,0,0,6" Height="30" ItemsSource="{Binding Source={x:Static local:EnumValues.FilterPresets}}" SelectedItem="{Binding FilterPreset}" ToolTip="Filter preset"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBlock Text="Sort By" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,8,0,4" />
                        <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox Grid.Column="0" Height="30" ItemsSource="{Binding Source={x:Static local:EnumValues.SortFields}}" SelectedItem="{Binding SortField}" ToolTip="Sort field"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><ui:Button Grid.Column="1" Appearance="Transparent" Padding="6" Margin="4,0,0,0" ToolTip="Sort direction" Click="ToggleSortDirection_Click"><ui:SymbolIcon Symbol="ArrowSortDownLines24" FontSize="14" /></ui:Button></Grid>
                        <TextBlock Text="Group By" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,8,0,4" />
                        <ComboBox Margin="0,0,0,6" Height="30" ItemsSource="{Binding Source={x:Static local:EnumValues.GroupFields}}" SelectedItem="{Binding GroupField}" ToolTip="Group by"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <Separator Background="{StaticResource Bridge.SeparatorBrush}" Margin="0,12,0,8" />
                        <TextBlock Text="Library" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,4" />
                        <ListBox SelectedItem="{Binding NavigationSection}" Background="Transparent" BorderThickness="0" Padding="0" ItemsSource="{Binding Source={x:Static local:EnumValues.NavigationSections}}"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6" /><Setter Property="Margin" Value="0,1" /><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Bridge.Card.Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="2,0,0,0" /><Setter Property="BorderBrush" Value="{StaticResource Bridge.SystemAccentBrush}" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ui:SymbolIcon FontSize="16" Width="20" Height="20" VerticalAlignment="Center" Foreground="{StaticResource TextFillColorSecondaryBrush}" Symbol="Library24"/><TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                        <Separator Background="{StaticResource Bridge.SeparatorBrush}" Margin="0,12,0,8" />
                        <ListBox SelectedItem="{Binding NavigationSection}" Background="Transparent" BorderThickness="0" Padding="0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6" /><Setter Property="Margin" Value="0,1" /><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Bridge.Card.Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="2,0,0,0" /><Setter Property="BorderBrush" Value="{StaticResource Bridge.SystemAccentBrush}" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBoxItem Tag="{x:Static enums:NavigationSection.Statistics}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ChartMultiple24" FontSize="16" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" /><TextBlock Text="Statistics" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" /></StackPanel></ListBoxItem><ListBoxItem Tag="{x:Static enums:NavigationSection.Settings}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" /><TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" /></StackPanel></ListBoxItem></ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Width="1" Background="{StaticResource Bridge.SeparatorBrush}" />
            <Grid Grid.Column="2" KeyboardNavigation.TabNavigation="Local">
                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.Grid}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.Table}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="200" /><ColumnDefinition Width="Auto" /><ColumnDefinition x:Name="DetailColumn" Width="380" MinWidth="0" /></Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0" Padding="4,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="4,12,0,6" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,6" /><Setter Property="Margin" Value="0,1" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Bridge.Card.Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="BorderBrush" Value="{StaticResource Bridge.SystemAccentBrush}" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Grid.Column="0" Height="32" Width="32" Stretch="Uniform" Source="{Binding Icon, Converter={StaticResource ImageUrlConverter}}" RenderOptions.BitmapScalingMode="Fant" /><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" FontSize="{StaticResource Bridge.FontSize.Body}" /></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{StaticResource Bridge.SeparatorBrush}" IsHitTestVisible="False" />
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="Transparent" />
                    <Border Grid.Column="2" Background="{StaticResource Bridge.Card.Background}" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="1,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Grid.Row="0"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><ui:SymbolIcon Symbol="Games32" FontSize="44" Foreground="{StaticResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" /><TextBlock Text="Select a game to see its details" Foreground="{StaticResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="{StaticResource Bridge.FontSize.Body}" /></StackPanel><Grid DataContext="{Binding SelectedGame}"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.SelectedGame, ElementName=Root}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,16,16,8"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="170" CornerRadius="4" Background="#1E1E1E" Margin="0,0,16,0"><Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="#000000"/></Border.Effect><Image Stretch="Uniform" Source="{Binding CoverImage, Converter={StaticResource ImageUrlConverter}}" RenderOptions.BitmapScalingMode="Fant"/></Border><StackPanel Grid.Column="1"><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="{StaticResource Bridge.FontSize.Title}" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"/><TextBlock Margin="0,4,0,0" FontSize="{StaticResource Bridge.FontSize.BodySmall}" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="{Binding ReleaseDate, Converter={StaticResource ReleaseDateConverter}, TargetNullValue=''}"/><TextBlock Margin="0,6,0,0" FontSize="{StaticResource Bridge.FontSize.BodySmall}" Foreground="{StaticResource TextFillColorSecondaryBrush}"><Run Text="Critic "/><Run Text="{Binding CriticScore, Mode=OneWay, TargetNullValue=''}" FontWeight="SemiBold"/><Run Text="/100  ·  Community "/><Run Text="{Binding CommunityScore, Mode=OneWay, TargetNullValue=''}" FontWeight="SemiBold"/><Run Text="/100"/></TextBlock><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><CheckBox Content="Favorite" IsChecked="{Binding Favorite}" Foreground="{StaticResource TextFillColorPrimaryBrush}" Margin="0,0,14,0"/><CheckBox Content="Hidden" IsChecked="{Binding Hidden}" Foreground="{StaticResource TextFillColorPrimaryBrush}"/></StackPanel></StackPanel></Grid><Border Height="1" Background="{StaticResource Bridge.SeparatorBrush}" Margin="0,12,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Details" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" TextOptions.TextFormattingMode="Display"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Release"/><TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding ReleaseDate, Converter={StaticResource ReleaseDateConverter}}"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Playtime"/><TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding PlaytimeSeconds, Mode=OneWay, Converter={StaticResource PlaytimeConverter}}"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Genre"/><TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding DataContext.GenresText, ElementName=Root, Mode=OneWay}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Library"/><TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding DataContext.LibraryText, ElementName=Root, Mode=OneWay}"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Dev"/><TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding DataContext.DevelopersText, ElementName=Root, Mode=OneWay}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Publisher"/><TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding DataContext.PublishersText, ElementName=Root, Mode=OneWay}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Platform"/><TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding DataContext.PlatformsText, ElementName=Root, Mode=OneWay}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,0,0,3" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="Install"/><TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource Bridge.SystemAccentBrush}" Text="{Binding InstallDirectory, Mode=OneWay, TargetNullValue='Not installed'}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Description" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" TextOptions.TextFormattingMode="Display"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" Padding="0" HorizontalAlignment="Stretch" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextFillColorSecondaryBrush}" FontSize="{StaticResource Bridge.FontSize.BodySmall}"/></StackPanel></Grid></StackPanel></ScrollViewer></Grid><ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="6,8" ToolTip="Collapse detail panel" Click="ToggleDetailPanel_Click" Panel.ZIndex="10"><ui:SymbolIcon Symbol="ChevronDoubleLeft20" FontSize="16"/></ui:Button></Grid><Border Grid.Row="1" Padding="12,10" BorderBrush="{StaticResource Bridge.SeparatorBrush}" BorderThickness="0,1,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><Button Command="{Binding DataContext.PlayGameCommand, ElementName=Root}" HorizontalAlignment="Stretch"><Button.Style><Style TargetType="Button"><Setter Property="Effect" Value="{x:Null}" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.55" Color="{StaticResource Bridge.Accent.Secondary.Color}" /></Setter.Value></Setter></Trigger></Style.Triggers></Style></Button.Style><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Bd" CornerRadius="2" Padding="16,9" Background="{StaticResource Bridge.Accent.SecondaryBrush}" BorderBrush="{StaticResource Bridge.Accent.SecondaryBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}" /><TextBlock Text="Play" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}" /></StackPanel></Button><UniformGrid Columns="3" Margin="0,8,0,0"><ui:Button Content="Save" Command="{Binding DataContext.SaveGameCommand, ElementName=Root}" /><ui:Button Content="Delete" Margin="6,0,0,0" Command="{Binding DataContext.DeleteGameCommand, ElementName=Root}" /><ui:Button Content="Metadata" Margin="6,0,0,0" ToolTip="Download metadata" Command="{Binding DataContext.DownloadMetadataCommand, ElementName=Root}" /></UniformGrid></StackPanel></Border></Grid></Border>
                </Grid>
                <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ViewMode}" Value="{x:Static enums:ViewMode.Grid}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><ListBox ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0" Padding="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid x:Name="Card" Width="200" Height="300"><Grid.RenderTransform><ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" CenterX="100" CenterY="150"/></Grid.RenderTransform><Grid.Effect><DropShadowEffect x:Name="CardShadow" BlurRadius="0" ShadowDepth="0" Direction="90" Opacity="0" Color="#000000"/></Grid.Effect><Border CornerRadius="8" ClipToBounds="True" Background="{StaticResource ApplicationBackgroundBrush}"><Grid><Image Stretch="UniformToFill" Source="{Binding CoverImage, Converter={StaticResource ImageUrlConverter}}" RenderOptions.BitmapScalingMode="Fant"/><Border VerticalAlignment="Bottom" Padding="10,24,10,8"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E6000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" Foreground="{StaticR