<ui:FluentWindow x:Class="Bridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bridge"
        xmlns:enums="clr-namespace:Bridge.Core.Enums;assembly=Bridge.Core"
        xmlns:converters="clr-namespace:Bridge.Converters"
        xmlns:controls="clr-namespace:Bridge.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:Bridge.Resources"
        xmlns:views="clr-namespace:Bridge.Views"
        xmlns:art="clr-namespace:Bridge.Assets"
        mc:Ignorable="d"
        x:Name="Root"
        Title="Bridge"
        Height="860" Width="1280"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <!-- Fondo borroso del juego seleccionado detrás del contenido. -->

        <Grid Grid.RowSpan="3" x:Name="GameBackgroundHost" IsHitTestVisible="False">
            <Grid.CacheMode><BitmapCache /></Grid.CacheMode>
            <controls:FadeImage SourceUrl="{Binding SelectedGame.BackgroundImage, Converter={StaticResource HeroArtSource}}" FallbackArtwork="{x:Static art:GameArtworkFallback.Background}" Stretch="UniformToFill" Width="{Binding ActualWidth, ElementName=Root}" Height="{Binding ActualHeight, ElementName=Root}"><controls:FadeImage.Effect><BlurEffect Radius="{StaticResource Bridge.Background.BlurRadius}" KernelType="Gaussian" RenderingBias="Performance" /></controls:FadeImage.Effect></controls:FadeImage>
            <Border Background="{DynamicResource Bridge.Background.DarkOverlay}" />
        </Grid>
        <ui:TitleBar x:Name="MainTitleBar" Grid.Row="0" Background="{DynamicResource Bridge.Sidebar.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="0,0,0,1" Height="56" ShowMinimize="True" ShowMaximize="True" ShowClose="True" SizeChanged="MainTitleBar_SizeChanged">
        <ui:TitleBar.Header>
            <Grid x:Name="TitleBarHeaderGrid" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle" WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button TabIndex="1" Width="44" Height="44" Margin="4,0,0,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{x:Static res:Strings.BridgeMenu}" AutomationProperties.Name="{x:Static res:Strings.BridgeMenu}" Click="MenuButton_Click"><Button.ContextMenu><ContextMenu Opened="MainMenu_Opened"><MenuItem Header="{x:Static res:Strings.AddGame}"><MenuItem.Icon><ui:SymbolIcon Symbol="Add24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon><MenuItem Header="{x:Static res:Strings.Import}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon><MenuItem Header="{x:Static res:Strings.Steam}" Command="{Binding PlacementTarget.DataContext.ImportSteamLibraryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.Epic}" Command="{Binding PlacementTarget.DataContext.ImportEpicLibraryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem></MenuItem><MenuItem Header="{x:Static res:Strings.ScanAutomatically}" Click="ScanInstalled_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Search24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ScanRoms}" Click="ScanRom_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="FolderSearch24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.AddManually}" Click="AddGame_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Edit24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem></MenuItem><MenuItem Header="{x:Static res:Strings.RefreshLibrary}" Command="{Binding PlacementTarget.DataContext.RefreshLibraryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.Support}"><MenuItem.Icon><ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon><MenuItem Header="{x:Static res:Strings.KoFi}" Click="OpenSupportLink_Click" Tag="{x:Static local:Config.KoFiUrl}"><MenuItem.Icon><ui:SymbolIcon Symbol="DrinkCoffee24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.GitHubSponsors}" Click="OpenSupportLink_Click" Tag="{x:Static local:Config.GitHubSponsorsUrl}"><MenuItem.Icon><ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem></MenuItem><MenuItem Header="{x:Static res:Strings.ThirdPartyClients}"><MenuItem.Icon><ui:SymbolIcon Symbol="Cloud24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.Sidebar}"><MenuItem.Icon><ui:SymbolIcon Symbol="PanelLeft24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon><MenuItem Header="{x:Static res:Strings.ShowSidebar}" Click="ToggleSidebar_Click"><MenuItem.Icon><ui:SymbolIcon FontSize="16"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Symbol" Value="Eye24"/><Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SidebarVisible}" Value="False"><Setter Property="Symbol" Value="EyeOff24"/><Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.Position}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowMove24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon><MenuItem Header="{x:Static res:Strings.Left}" Click="SetSidebarPosition_Click" Tag="Left" IsChecked="True"><MenuItem.Icon><ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.Right}" Click="SetSidebarPosition_Click" Tag="Right"><MenuItem.Icon><ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.Top}" Click="SetSidebarPosition_Click" Tag="Top"><MenuItem.Icon><ui:SymbolIcon Symbol="ChevronUp24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.Bottom}" Click="SetSidebarPosition_Click" Tag="Bottom"><MenuItem.Icon><ui:SymbolIcon Symbol="ChevronDown24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem></MenuItem></MenuItem><MenuItem Header="{x:Static res:Strings.Theme}"><MenuItem.Icon><ui:SymbolIcon Symbol="Color24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon><MenuItem Header="{x:Static res:Strings.ThemeBlue}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#007ACC"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#007ACC"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemeCyan}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#00B4D8"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#00B4D8"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemeTeal}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#14B8A6"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#14B8A6"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemeGreen}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#10B981"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#10B981"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemePurple}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#8B5CF6"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#8B5CF6"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemePink}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#EC4899"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#EC4899"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemeRed}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#EF4444"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#EF4444"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemeOrange}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#F97316"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#F97316"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ThemeAmber}" IsCheckable="True" Click="SetThemeColor_Click" Tag="#F59E0B"><MenuItem.Icon><Border Width="14" Height="14" CornerRadius="3" Background="#F59E0B"/></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.CustomTheme}" Click="CustomThemeColor_Click"/></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.Settings}"><MenuItem.Icon><ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon><MenuItem Header="{x:Static res:Strings.MenuAllSettings}" Click="ShowSettings_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.IgdbMenu}" Click="IgdbSettings_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Database24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.ConfigureEmulatorTitle}" Click="ConfigureEmulator_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Box24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.SettingsStartWithWindows}" IsCheckable="True" Click="ToggleStartWithWindows_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Power24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.SettingsTrayIconTitle}" IsCheckable="True" Click="ToggleTrayIcon_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="TrayItemAdd24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{x:Static res:Strings.SettingsLanguageTitle}"><MenuItem.Icon><ui:SymbolIcon Symbol="LocalLanguage24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon><MenuItem Header="{x:Static res:Strings.SettingsLanguageEnglish}" IsCheckable="True" Click="SetLanguage_Click" Tag="English" Style="{StaticResource Bridge.CheckableMenuItem}"/><MenuItem Header="{x:Static res:Strings.SettingsLanguageSpanish}" IsCheckable="True" Click="SetLanguage_Click" Tag="Spanish" Style="{StaticResource Bridge.CheckableMenuItem}"/></MenuItem></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.CheckForUpdates}" Command="{Binding PlacementTarget.DataContext.CheckForUpdatesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.AboutBridge}" Click="About_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="{x:Static res:Strings.Exit}" Click="Exit_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="Power24" FontSize="16" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu><Image Source="{StaticResource Bridge.LogoImage}" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.92"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Button>
                <Border x:Name="SearchBoxHost" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="10,0" Height="40" Margin="5,0,0,0" Width="{x:Static local:LayoutMetrics.ListColumnWidth}" WindowChrome.IsHitTestVisibleInChrome="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Search24" FontSize="20" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox x:Name="SearchBox" Grid.Column="1" TabIndex="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center" Padding="0,1" Foreground="{StaticResource TextFillColorPrimaryBrush}" AutomationProperties.Name="{x:Static res:Strings.SearchGames}" ToolTip="{x:Static res:Strings.SearchGamesTooltip}" /></Grid></Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button TabIndex="3" Width="40" Height="40" Background="Transparent" BorderThickness="0" Margin="0,0,0,0" ToolTip="{x:Static res:Strings.FilterPresets}" AutomationProperties.Name="{x:Static res:Strings.FilterPresets}" Cursor="Hand" Click="MenuButton_Click"><Button.ContextMenu><ContextMenu Name="FilterPresetMenu" DataContext="{Binding}"><MenuItem Header="{x:Static res:Strings.All}" IsCheckable="True" IsChecked="{Binding FilterPreset, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=All}" Click="FilterPresetMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="All" /><MenuItem Header="{x:Static res:Strings.Favorites}" IsCheckable="True" IsChecked="{Binding FilterPreset, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Favorite}" Click="FilterPresetMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="Favorite" /><MenuItem Header="{x:Static res:Strings.Installed}" IsCheckable="True" IsChecked="{Binding FilterPreset, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Installed}" Click="FilterPresetMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="Installed" /><MenuItem Header="{x:Static res:Strings.NotPlayedFilter}" IsCheckable="True" IsChecked="{Binding FilterPreset, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=NotPlayed}" Click="FilterPresetMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="NotPlayed" /><MenuItem Header="{x:Static res:Strings.RecentlyPlayed}" IsCheckable="True" IsChecked="{Binding FilterPreset, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=RecentlyPlayed}" Click="FilterPresetMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="RecentlyPlayed" /></ContextMenu></Button.ContextMenu><ui:SymbolIcon Symbol="Filter24" FontSize="22"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon></Button>
                <Button TabIndex="4" Width="40" Height="40" Background="Transparent" BorderThickness="0" Margin="2,0,0,0" ToolTip="{x:Static res:Strings.SortSettings}" AutomationProperties.Name="{x:Static res:Strings.SortSettings}" Cursor="Hand" Click="MenuButton_Click"><Button.ContextMenu><ContextMenu Name="SortFieldMenu" DataContext="{Binding}"><MenuItem Header="{x:Static res:Strings.Name}" IsCheckable="True" IsChecked="{Binding SortField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Name}" Click="SortFieldMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="Name" /><MenuItem Header="{x:Static res:Strings.TimePlayed}" IsCheckable="True" IsChecked="{Binding SortField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=PlaytimeSeconds}" Click="SortFieldMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="PlaytimeSeconds" /><MenuItem Header="{x:Static res:Strings.PlayCount}" IsCheckable="True" IsChecked="{Binding SortField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=PlayCount}" Click="SortFieldMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="PlayCount" /><MenuItem Header="{x:Static res:Strings.LastPlayed}" IsCheckable="True" IsChecked="{Binding SortField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=LastPlayed}" Click="SortFieldMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="LastPlayed" /><MenuItem Header="{x:Static res:Strings.ReleaseDate}" IsCheckable="True" IsChecked="{Binding SortField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=ReleaseDate}" Click="SortFieldMenu_Click" Style="{StaticResource Bridge.CheckableMenuItem}" Tag="ReleaseDate" /><MenuItem Header="{x:Static res:Strings.Developer}" IsCheckable="True" IsChecked="{Binding SortField, Mode=OneWay, Converter={StaticResource EnumMatch}, ConverterParameter=Developer}" Click="SortFieldMenu_Click" Style="{StaticResource Bridge.Ch