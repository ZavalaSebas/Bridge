<Window x:Class="Bridge.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Bridge"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize"
        Foreground="{StaticResource TextFillColorPrimaryBrush}">
    <Border Margin="0" CornerRadius="10" Background="{DynamicResource Bridge.Card.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1" Padding="20,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>
        <StackPanel MaxWidth="380">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ui:SymbolIcon x:Name="MessageIcon" Symbol="Info24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="MessageTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" FontSize="13" Foreground="{StaticResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="19"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="OkButton" Content="OK" Width="86" Padding="0,5" Click="Ok_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="86" Margin="8,0,0,0" Padding="0,5" Visibility="Collapsed" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>