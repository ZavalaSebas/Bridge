<ui:FluentWindow x:Class="Bridge.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Name="Root"
        Width="480"
        SizeToContent="Height"
        MinHeight="200"
        MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Background="{DynamicResource Bridge.Sidebar.Background}"
                     BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                     BorderThickness="0,0,0,1"
                     Height="56"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:SymbolIcon x:Name="MessageIcon" Symbol="Info24" FontSize="18"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="MessageTitle" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16,24,12">
            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       Foreground="{StaticResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="19"/>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,12,20,16"
                BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Bridge.Sidebar.Background}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="100"
                        Padding="0,7"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton"
                        Content="OK"
                        Width="100"
                        Padding="0,7"
                        IsDefault="True"
                        Click="Ok_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
