<Window x:Class="Bridge.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="About Bridge"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="480" Height="560"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="430">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                <ui:SymbolIcon Symbol="Library24" FontSize="26" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Bridge" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Version 0.1.0" TextAlignment="Center" FontSize="13" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="0,2,0,4"/>
            <TextBlock Text="A local game library, unified — no plugins, no bloat, just your games."
                       TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"/>

            <Border Background="{DynamicResource Bridge.Card.Background}" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" LineHeight="17">
                    Bridge unifies your games — from external libraries, manual entries and emulated ROMs — into
                    one fast, local, self-contained catalog. Incremental import, local metadata, fast virtualized
                    views and emulation support, without a plugin runtime or a separate fullscreen frontend.
                    Playnite is an inspiration, not a specification: Bridge's structure, architecture and
                    implementation are its own.
                </TextBlock>
            </Border>

            <TextBlock Text="Project" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,8"/>
            <TextBlock FontSize="13" Margin="0,0,0,6"><Hyperlink NavigateUri="https://github.com/ZavalaSebas/Bridge" RequestNavigate="Link_Click" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">github.com/ZavalaSebas/Bridge</Hyperlink></TextBlock>
            <TextBlock FontSize="13"><Hyperlink NavigateUri="https://github.com/ZavalaSebas/Bridge/blob/main/LICENSE" RequestNavigate="Link_Click" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">License (GPL v3)</Hyperlink></TextBlock>

            <TextBlock Text="Support" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,18,0,8"/>
            <TextBlock FontSize="13" Margin="0,0,0,6"><Hyperlink NavigateUri="https://ko-fi.com/YOUR_KOFI" RequestNavigate="Link_Click" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">Buy me a Ko-fi</Hyperlink></TextBlock>
            <TextBlock FontSize="13"><Hyperlink NavigateUri="https://github.com/sponsors/ZavalaSebas" RequestNavigate="Link_Click" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">Sponsor on GitHub</Hyperlink></TextBlock>

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,18,0,0" LineHeight="15">
                Made with care by ZavalaSebas. This software is provided "as is", without warranty of any kind.
                Bridge is not affiliated with, endorsed by, or connected to Playnite, Valve/Steam, GOG or any
                platform or emulator project.
            </TextBlock>

            <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Center" Width="90" Margin="0,22,0,0" Padding="0,6"/>
        </StackPanel>
    </ScrollViewer>
</Window>
