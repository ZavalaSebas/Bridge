<ui:FluentWindow x:Class="Bridge.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Bridge.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Name="Root"
        Title="About Bridge"
        Width="540" Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
            <Grid.CacheMode><BitmapCache/></Grid.CacheMode>
            <controls:FadeImage x:Name="BackgroundArt" Stretch="UniformToFill" Width="{Binding ActualWidth, ElementName=Root}" Height="{Binding ActualHeight, ElementName=Root}"><controls:FadeImage.Effect><BlurEffect Radius="{StaticResource Bridge.Background.BlurRadius}" KernelType="Gaussian" RenderingBias="Performance"/></controls:FadeImage.Effect></controls:FadeImage>
            <Border Background="{StaticResource Bridge.Background.DarkOverlay}"/>
        </Grid>

        <ui:TitleBar Grid.Row="0" Background="{DynamicResource Bridge.Sidebar.Background}" BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="0,0,0,1" Height="56" ShowMinimize="False" ShowMaximize="False" ShowClose="True"><ui:TitleBar.Header>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ui:SymbolIcon Symbol="Info24" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="About Bridge" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </ui:TitleBar.Header></ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,12,20,20">
            <StackPanel MaxWidth="452" HorizontalAlignment="Center">

                <!-- Hero: icono + nombre + versión -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
                    <Border Width="64" Height="64" CornerRadius="16" Background="#33007ACC" BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="1">
                        <ui:SymbolIcon Symbol="Library24" FontSize="30" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Bridge" FontSize="{StaticResource Bridge.FontSize.TitleLarge}" FontWeight="SemiBold"/>
                        <Border Margin="0,3,0,0" Padding="8,2" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Descripción -->
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" LineHeight="17" Margin="0,0,0,16">
                    Bridge unifies your games — from external libraries, manual entries and emulated ROMs — into
                    one fast, local, self-contained catalog. Incremental import, local metadata, fast virtualized
                    views and emulation support, without a plugin runtime or a separate fullscreen frontend.
                    Playnite is an inspiration, not a specification: Bridge's structure, architecture and
                    implementation are its own.
                </TextBlock>

                <!-- Proyecto -->
                <TextBlock Text="Project" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="2,0,0,8"/>
                <ItemsControl x:Name="ProjectLinks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="LinkRow_Click" Tag="{Binding Url}" Padding="0" Margin="0,0,0,6" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="13"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ui:SymbolIcon Grid.Column="2" Symbol="ArrowUpRight24" FontSize="14" Foreground="{StaticResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#22007ACC"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Soporte -->
                <TextBlock Text="Support" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="2,10,0,8"/>
                <ItemsControl x:Name="SupportLinks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="LinkRow_Click" Tag="{Binding Url}" Padding="0" Margin="0,0,0,6" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}" FontSize="18" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="13"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ui:SymbolIcon Grid.Column="2" Symbol="ArrowUpRight24" FontSize="14" Foreground="{StaticResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#22007ACC"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Entorno -->
                <TextBlock Text="Environment" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="2,10,0,8"/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                        <ui:SymbolIcon Symbol="Apps24" FontSize="15" Foreground="{StaticResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="RuntimeText" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                        <ui:SymbolIcon Symbol="Globe24" FontSize="15" Foreground="{StaticResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="OsText" FontSize="12" Foreground="{StaticResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Disclaimer legal -->
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="2,16,0,0" LineHeight="15">
                    Made with care by ZavalaSebas. This software is provided "as is", without warranty of any kind.
                    Bridge is not affiliated with, endorsed by, or connected to Playnite, Valve/Steam, GOG or any
                    platform or emulator project.
                </TextBlock>

                <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Center" Width="100" Margin="0,20,0,0" Padding="0,7"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>