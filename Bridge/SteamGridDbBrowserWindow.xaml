<ui:FluentWindow x:Class="Bridge.SteamGridDbBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        x:Name="Root"
        Title="{x:Static res:Strings.SteamGridDbBrowserTitle}"
        Width="920" Height="680"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}"
        xmlns:res="clr-namespace:Bridge.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Background="{DynamicResource Bridge.Sidebar.Background}"
                     BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                     BorderThickness="0,0,0,1"
                     Height="56"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:SymbolIcon Symbol="Globe24" FontSize="18"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Static res:Strings.SteamGridDbBrowserTitle}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Border Grid.Row="1"
                Margin="12,8,12,0"
                Padding="10,8"
                Background="#18007ACC"
                BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Text="{x:Static res:Strings.SteamGridDbBrowserTrustNote}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
        </Border>

        <Border Grid.Row="2"
                Margin="12,0,12,0"
                BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <wv2:WebView2 x:Name="Browser"/>
        </Border>

        <Border Grid.Row="3"
                Padding="20,10,20,14"
                BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Bridge.Sidebar.Background}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Padding="0,6" Margin="0,0,16,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Refresh_Click">
                        <TextBlock Text="{x:Static res:Strings.SteamGridDbBrowserRefresh}"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   TextDecorations="Underline"/>
                    </Button>
                    <Button Padding="0,6" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OpenExternal_Click">
                        <TextBlock Text="{x:Static res:Strings.SteamGridDbBrowserOpenExternal}"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   TextDecorations="Underline"/>
                    </Button>
                </StackPanel>
                <Button Content="{x:Static res:Strings.Close}" HorizontalAlignment="Right" Width="100" Padding="0,7" IsCancel="True" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
