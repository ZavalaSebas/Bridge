<Window x:Class="Bridge.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Game" Height="180" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Name" />
        <TextBox x:Name="NameBox" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" IsCancel="True" />
            <Button Content="Add" Width="80" Margin="8,0,0,0" IsDefault="True" Click="Add_Click" />
        </StackPanel>
    </StackPanel>
</Window>
