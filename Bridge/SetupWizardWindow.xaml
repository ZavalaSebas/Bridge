<ui:FluentWindow x:Class="Bridge.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:res="clr-namespace:Bridge.Resources"
        x:Name="Root"
        Title="{x:Static res:Strings.SetupWizardTitle}"
        Width="640"
        Height="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Background="{DynamicResource Bridge.Sidebar.Background}"
                     BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                     BorderThickness="0,0,0,1"
                     Height="56"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="False">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="18"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="HeaderTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Border Grid.Row="1" Padding="24,16,24,0">
            <StackPanel>
                <TextBlock x:Name="StepTitle" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="StepDescription"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           FontSize="13"
                           LineHeight="18"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16,24,8">
            <StackPanel x:Name="StepsHost">
                <StackPanel x:Name="ProfileStep">
                    <Border CornerRadius="8"
                            Background="{DynamicResource Bridge.Card.Background}"
                            BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SetupDisplayNameLabel}"
                                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <TextBox x:Name="DisplayNameBox"
                                     Padding="8,6"
                                     MaxLength="40"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8"
                            Background="{DynamicResource Bridge.Card.Background}"
                            BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SetupAvatarLabel}"
                                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="72" Height="72" CornerRadius="36" ClipToBounds="True"
                                        BorderBrush="{DynamicResource Bridge.SeparatorBrush}" BorderThickness="1">
                                    <Image x:Name="AvatarPreview" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Button x:Name="ChoosePhotoButton"
                                            HorizontalAlignment="Left"
                                            Padding="12,6"
                                            Click="ChoosePhoto_Click"
                                            Content="{x:Static res:Strings.SetupChoosePhoto}"/>
                                    <Button x:Name="UseDefaultAvatarButton"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            Padding="12,6"
                                            Click="UseDefaultAvatar_Click"
                                            Content="{x:Static res:Strings.SetupUseDefaultAvatar}"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid x:Name="DefaultAvatarGrid" Columns="6" Rows="1"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="LibrariesStep" Visibility="Collapsed">
                    <Border CornerRadius="8"
                            Background="{DynamicResource Bridge.Card.Background}"
                            BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SetupStoreLibrariesTitle}"
                                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="{x:Static res:Strings.SetupStoreLibrariesHelp}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,12"/>

                            <Border x:Name="SteamDetectedCard"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,8"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <DockPanel LastChildFill="True">
                                    <ui:SymbolIcon DockPanel.Dock="Left"
                                                   Symbol="CheckmarkCircle24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="SteamStatusText" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SteamStatusHelp"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border x:Name="EpicDetectedCard"
                                    CornerRadius="6"
                                    Padding="12"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <DockPanel LastChildFill="True">
                                    <ui:SymbolIcon DockPanel.Dock="Left"
                                                   Symbol="CheckmarkCircle24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="EpicStatusText" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="EpicStatusHelp"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8"
                            Background="{DynamicResource Bridge.Card.Background}"
                            BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="15"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.SetupExternalGamesFolderTitle}"
                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SetupExternalGamesFolderHelp}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,10"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="{x:Static res:Strings.Browse}"
                                        Width="90"
                                        Padding="10,6"
                                        Margin="8,0,0,0"
                                        Click="BrowseExternalGamesFolder_Click"/>
                                <TextBox x:Name="ExternalGamesFolderBox"
                                         Padding="6,4"
                                         VerticalContentAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RomFolderStep" Visibility="Collapsed">
                    <Border CornerRadius="8"
                            Background="{DynamicResource Bridge.Card.Background}"
                            BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Games24" FontSize="15"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static res:Strings.SetupRomFolderTitle}"
                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SetupRomFolderHelp}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,10"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="{x:Static res:Strings.Browse}"
                                        Width="90"
                                        Padding="10,6"
                                        Margin="8,0,0,0"
                                        Click="BrowseRomFolder_Click"/>
                                <TextBox x:Name="RomFolderBox"
                                         Padding="6,4"
                                         VerticalContentAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                            BorderThickness="1"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SetupReadyTitle}"
                                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="{x:Static res:Strings.SetupReadyHelp}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Padding="20,12,20,16"
                BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Bridge.Sidebar.Background}">
            <DockPanel>
                <TextBlock x:Name="StepIndicator"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           FontSize="12"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton"
                            MinWidth="90"
                            Padding="14,7"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="Back_Click"
                            Content="{x:Static res:Strings.SetupBack}"/>
                    <Button x:Name="NextButton"
                            MinWidth="120"
                            Padding="14,7"
                            IsDefault="True"
                            Click="Next_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextOnAccentFillColorPrimaryBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorSecondaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
