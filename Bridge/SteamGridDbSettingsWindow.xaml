<ui:FluentWindow x:Class="Bridge.SteamGridDbSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Name="Root"
        Title="{x:Static res:Strings.SteamGridDbSettingsTitle}"
        Width="520" Height="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        MinHeight="560" MinWidth="480"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource Bridge.FontFamily}"
        FontSize="{StaticResource Bridge.FontSize.Body}"
        xmlns:res="clr-namespace:Bridge.Resources">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Background="{DynamicResource Bridge.Sidebar.Background}"
                     BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                     BorderThickness="0,0,0,1"
                     Height="56"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="18"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Static res:Strings.SteamGridDbSettingsTitle}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,4">
            <StackPanel Margin="24,18,24,20">
                <TextBlock Text="{x:Static res:Strings.SteamGridDbSettingsIntro}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           LineHeight="20"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{x:Static res:Strings.SteamGridDbApiKeyNeeded}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextFillColorPrimaryBrush}"
                           FontWeight="Medium"
                           Margin="0,0,0,16"/>

                <Border CornerRadius="8"
                        Background="{DynamicResource Bridge.Card.Background}"
                        BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                        BorderThickness="1"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SteamGridDbObtainKeyHeading}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,10"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" LineHeight="22">
                            <Run Text="1. "/><Run Text="{x:Static res:Strings.SteamGridDbTutorialStep1}"/>
                            <LineBreak/>
                            <Run Text="2. "/><Run Text="{x:Static res:Strings.SteamGridDbTutorialStep2}"/>
                            <LineBreak/>
                            <Run Text="3. "/><Run Text="{x:Static res:Strings.SteamGridDbTutorialStep3}"/>
                            <LineBreak/>
                            <Run Text="4. "/><Run Text="{x:Static res:Strings.SteamGridDbTutorialStep4}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Recommended: system browser -->
                <Border CornerRadius="8"
                        Background="#332A6EB8"
                        BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Button HorizontalAlignment="Stretch"
                                Padding="14,11"
                                Cursor="Hand"
                                Click="OpenInBrowser_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextOnAccentFillColorPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="{x:Static res:Strings.SteamGridDbOpenPreferences}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Margin="0,12,0,0"
                                Background="{DynamicResource Bridge.Sidebar.Background}"
                                BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="ArrowClockwise24"
                                               FontSize="16"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               VerticalAlignment="Top"
                                               Margin="0,1,8,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Static res:Strings.SteamGridDbRefreshCallout}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Static res:Strings.SteamGridDbApiKeyLabel}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,4,0,6"/>
                <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,8" Padding="8,6"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <!-- Optional: embedded browser -->
                <Border CornerRadius="8"
                        Background="{DynamicResource Bridge.Card.Background}"
                        BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                        BorderThickness="1"
                        Padding="14,12"
                        Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SteamGridDbInAppTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                   Margin="0,0,0,8"/>
                        <Button HorizontalAlignment="Left"
                                Padding="0,4"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OpenInApp_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Window24"
                                               FontSize="14"
                                               Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                <TextBlock Text="{x:Static res:Strings.SteamGridDbOpenInApp}"
                                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                           TextDecorations="Underline"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Static res:Strings.SteamGridDbInAppHint}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource TextFillColorTertiaryBrush}"
                                   LineHeight="18"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,12,20,16"
                BorderBrush="{DynamicResource Bridge.SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Bridge.Sidebar.Background}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True" Width="100" Padding="0,7" Margin="0,0,8,0"/>
                <Button Content="{x:Static res:Strings.Save}" Width="100" Padding="0,7" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
