<Window x:Class="Bridge.GameEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Bridge.Converters"
        Title="Edit Game"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Width="620" Height="680"
        Background="{StaticResource ApplicationBackgroundBrush}"
        Foreground="{StaticResource TextFillColorPrimaryBrush}"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8" MaxWidth="520">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Release Date" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReleaseDateText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8" ToolTip="YYYY, YYYY-MM or YYYY-MM-DD"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Critic Score" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CriticScoreText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Community Score" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CommunityScoreText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8"/>

                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox Content="Favorite" IsChecked="{Binding Favorite}" Margin="0,0,16,0"/>
                            <CheckBox Content="Hidden" IsChecked="{Binding Hidden}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Description" VerticalAlignment="Top" Margin="0,2,10,0" Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" Padding="6,4" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Genres" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding Genres}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2,14,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Developers" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,14,0,6"/>
                        <ItemsControl ItemsSource="{Binding Developers}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2,14,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Publishers" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,14,0,6"/>
                        <ItemsControl ItemsSource="{Binding Publishers}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2,14,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Platforms" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,14,0,6"/>
                        <ItemsControl ItemsSource="{Binding Platforms}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2,14,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Install Directory" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,14,0,6"/>
                        <TextBox Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Media">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Icon" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="48" Height="48" Background="#1B2132" CornerRadius="4" Margin="0,0,10,0">
                                <Image Stretch="Uniform" converters:CachedImage.SourceUrl="{Binding Icon}" RenderOptions.BitmapScalingMode="Fant"/>
                            </Border>
                            <TextBox Width="400" VerticalAlignment="Center" Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            <Button Content="Browse..." Margin="8,0,0,0" Padding="12,6" VerticalAlignment="Center" Click="Browse_Click" Tag="Icon"/>
                        </StackPanel>

                        <TextBlock Text="Cover Image" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,16,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="40" Height="60" Background="#1B2132" CornerRadius="4" Margin="0,0,10,0">
                                <Image Stretch="Uniform" converters:CachedImage.SourceUrl="{Binding CoverImage}" RenderOptions.BitmapScalingMode="Fant"/>
                            </Border>
                            <TextBox Width="400" VerticalAlignment="Center" Text="{Binding CoverImage, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            <Button Content="Browse..." Margin="8,0,0,0" Padding="12,6" VerticalAlignment="Center" Click="Browse_Click" Tag="CoverImage"/>
                        </StackPanel>

                        <TextBlock Text="Background Image" FontWeight="SemiBold" Foreground="{StaticResource TextFillColorTertiaryBrush}" Margin="0,16,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="80" Height="44" Background="#1B2132" CornerRadius="4" Margin="0,0,10,0">
                                <Image Stretch="UniformToFill" converters:CachedImage.SourceUrl="{Binding BackgroundImage}" RenderOptions.BitmapScalingMode="Fant"/>
                            </Border>
                            <TextBox Width="400" VerticalAlignment="Center" Text="{Binding BackgroundImage, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            <Button Content="Browse..." Margin="8,0,0,0" Padding="12,6" VerticalAlignment="Center" Click="Browse_Click" Tag="BackgroundImage"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save" IsDefault="True" Padding="18,7" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" Padding="18,7"/>
        </StackPanel>
    </Grid>
</Window>
