<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bridge.Storage</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- CVE-2025-6965 (GHSA-2m69-gcr7-jv3q, High): EF Core Sqlite 10.0.10 pulls
         SQLitePCLRaw.bundle_e_sqlite3 2.1.11, whose lib.e_sqlite3 bundles SQLite
         3.49.1 (< 3.50.2, memory corruption). The 2.1.x line has no patched
         release, so pin the 3.x bundle directly: it drops lib.e_sqlite3 entirely
         in favor of SourceGear.sqlite3 (SQLite 3.50.4). Verified by the EF Core
         round-trip tests, which exercise the real native SQLite binary. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bridge.Core\Bridge.Core.csproj" />
  </ItemGroup>

</Project>
